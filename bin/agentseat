#!/usr/bin/env python3
"""Operate one foreground application through the isolated AgentSeat wrapper.

The implementation lives in lib/agentseat_cli. Loading this file as a module
(as some live fixtures do) exposes the controller's names read-only.
"""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

import agentseat_cli
from agentseat_cli import cli, common

_CONTROLLER = None


def __getattr__(name: str):
    global _CONTROLLER
    if _CONTROLLER is None:
        _CONTROLLER = agentseat_cli.Controller()
    return getattr(_CONTROLLER, name)


if __name__ == "__main__":
    try:
        raise SystemExit(cli.main())
    except common.AgentSeatError as exc:
        print(json.dumps({"error": str(exc)}, ensure_ascii=False), file=sys.stderr)
        raise SystemExit(1)
