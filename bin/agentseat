DEFAULT_PREFERENCES: dict[str, Any] = {
    "default_workspace": 1,
    "human_priority_grace_ms": 1500,
    "eye_hud": False,
    "language": "auto",
}
PREFERENCES = dict(DEFAULT_PREFERENCES)


class AgentSeatError(RuntimeError):
    pass


def run(argv: list[str], *, env: dict[str, str] | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(argv, text=True, capture_output=True, env=env, check=False)
    if check and result.returncode:
        raise AgentSeatError(
            result.stderr.strip() or result.stdout.strip() or _("command failed: {command}").format(command=argv[0])
        )
    return result


def output_json(value: Any) -> None:
    print(json.dumps(value, ensure_ascii=False, indent=2))


def storage_paths() -> dict[str, Any]:
    return {
        "instance": SELECTED_INSTANCE or "default",
        "python_sdk": str((ROOT / "share/python/agentseat_client.py") if (ROOT / "share/python/agentseat_client.py").exists() else ROOT / "python/agentseat_client.py"),
        "config": str(CONFIG_HOME),
        "config_file": str(CONFIG_FILE),
        "data": str(DATA_HOME),
        "state": str(STATE_HOME),
        "logs": str(LOG_DIR),
        "captures": str(EVIDENCE),
        "cache": str(CACHE_HOME),
        "runtime": str(RUNTIME),
        "privacy": {
            "chat": _("memory-only; cleared when the daemon exits"),
            "runtime": _("volatile; removed by the user session runtime manager"),
            "captures": _("written only when observe is requested"),
        },
    }


def load_preferences() -> dict[str, Any]:
    preferences = dict(DEFAULT_PREFERENCES)
    if not CONFIG_FILE.exists():
        return preferences
    try:
        raw = tomllib.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise AgentSeatError(
            _("cannot read AgentSeat configuration {path}: {error}").format(path=CONFIG_FILE, error=exc)
        ) from exc
    general = raw.get("general", {})
    if not isinstance(general, dict):
        raise AgentSeatError(_("AgentSeat configuration [general] must be a table"))
    for name in preferences:
        if name in general:
            preferences[name] = general[name]
    workspace = preferences["default_workspace"]
    grace_ms = preferences["human_priority_grace_ms"]
    eye_hud = preferences["eye_hud"]
    language = preferences["language"]
    if not isinstance(workspace, int) or isinstance(workspace, bool) or workspace < 1:
        raise AgentSeatError(_("general.default_workspace must be a positive integer"))
    if not isinstance(grace_ms, int) or isinstance(grace_ms, bool) or not 0 <= grace_ms <= 60_000:
        raise AgentSeatError(_("general.human_priority_grace_ms must be an integer from 0 to 60000"))
    if not isinstance(eye_hud, bool):
        raise AgentSeatError(_("general.eye_hud must be true or false"))
    if not isinstance(language, str):
        raise AgentSeatError(_("general.language must be auto, en, zh-CN, or zh-TW"))
    if language.casefold() != "auto":
        base = language.split(".", 1)[0].split("@", 1)[0]
        if base.casefold() not in SUPPORTED_LANGUAGES:
            raise AgentSeatError(_("general.language must be auto, en, zh-CN, or zh-TW"))
        preferences["language"] = LANGUAGE_NAMES[SUPPORTED_LANGUAGES[base.casefold()]]
    return preferences


def configuration_status() -> dict[str, Any]:
    return {
        "path": str(CONFIG_FILE),
        "exists": CONFIG_FILE.is_file(),
        "effective": dict(PREFERENCES),
        "resolved_language": LANGUAGE_NAMES[CURRENT_LANGUAGE],
        "locale_dir": str(CURRENT_LOCALE_DIR) if CURRENT_LOCALE_DIR else None,
    }


def ensure_private_directory(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        path.chmod(0o700)
    except OSError:
        pass


def ensure_runtime_storage() -> None:
    for path in (RUNTIME, DATA_HOME, STATE_HOME, CACHE_HOME, LOG_DIR, EVIDENCE):
        ensure_private_directory(path)


@contextmanager
def lifecycle_lock() -> Any:
    """Serialize start/stop transactions for one runtime namespace."""
    ensure_private_directory(RUNTIME)
    flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(LIFECYCLE_LOCK, flags, 0o600)
    except OSError as exc:
        message = _("refusing to use an unexpected AgentSeat lifecycle lock: {path}").format(
            path=LIFECYCLE_LOCK
        )
        raise AgentSeatError(f"{message}: {exc}") from exc
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
            raise AgentSeatError(
                _("refusing to use an unexpected AgentSeat lifecycle lock: {path}").format(path=LIFECYCLE_LOCK)
            )
        os.fchmod(descriptor, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def atomic_write_private_text(path: Path, content: str) -> None:
    ensure_private_directory(path.parent)
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    try:
        temporary.write_text(content, encoding="utf-8")
        os.chmod(temporary, 0o600)
        temporary.replace(path)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def open_private_log(path: Path) -> Any:
    ensure_private_directory(path.parent)
    stream = path.open("ab", buffering=0)
    os.chmod(path, 0o600)
    return stream


def version() -> dict[str, Any]:
    result: dict[str, Any] = {
        "controller": "agentseat",
        "version": AGENTSEAT_VERSION,
        "protocol_version": 2,
        "daemon": None,
    }
    if CONTROL_SOCKET.exists():
        try:
            result["daemon"] = rpc("version")
        except AgentSeatError as exc:
            result["daemon_error"] = str(exc)
    return result


def instances() -> list[dict[str, Any]]:
    return json.loads(run(["hyprctl", "instances", "-j"]).stdout)


def proc_exe(pid: int) -> str:
    try:
        return os.readlink(f"/proc/{pid}/exe")
    except OSError:
        return ""


def proc_argv(pid: int) -> list[str]:
    try:
        encoded = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return []
    return [item.decode(errors="replace") for item in encoded.split(b"\0") if item]


def proc_environment_value(pid: int, name: str) -> str | None:
    try:
        encoded = Path(f"/proc/{pid}/environ").read_bytes()
    except OSError:
        return None
    prefix = os.fsencode(f"{name}=")
    for item in encoded.split(b"\0"):
        if item.startswith(prefix):
            return os.fsdecode(item[len(prefix):])
    return None


def argv_has_pair(pid: int, option: str, expected: Path) -> bool:
    argv = proc_argv(pid)
    return any(
        value == option and index + 1 < len(argv) and argv[index + 1] == str(expected)
        for index, value in enumerate(argv)
    )


def executable_name(pid: int) -> str:
    executable = proc_exe(pid).removesuffix(" (deleted)")
    return Path(executable).name if executable else ""


def daemon_belongs_to_runtime(pid: int) -> bool:
    if executable_name(pid) != NATIVE_DAEMON.name:
        return False
    return argv_has_pair(pid, "--socket", CONTROL_SOCKET)


def microhost_belongs_to_runtime(pid: int, runtime: Path | None = None) -> bool:
    target_runtime = runtime if runtime is not None else RUNTIME
    return (
        executable_name(pid) == MICROHOST_EXE.name
        and proc_environment_value(pid, "AGENTSEAT_RUNTIME_DIR") == str(target_runtime)
    )


def eye_belongs_to_runtime(pid: int) -> bool:
    return (
        executable_name(pid) == EYE_BINARY.name
        and argv_has_pair(pid, "--socket", CONTROL_SOCKET)
    )


def list_instances() -> dict[str, Any]:
    instances: list[dict[str, Any]] = []
    if not INSTANCE_RUNTIME_ROOT.is_dir():
        return {"count": 0, "instances": instances}
    for runtime in sorted(INSTANCE_RUNTIME_ROOT.iterdir(), key=lambda item: item.name):
        if runtime.is_symlink() or not runtime.is_dir():
            continue
        if not re.fullmatch(r"app-[0-9a-f]{24}", runtime.name):
            continue
        state_path = runtime / "state.json"
        try:
            state_value = json.loads(state_path.read_text(encoding="utf-8"))
        except (FileNotFoundError, OSError, json.JSONDecodeError):
            continue
        try:
            instance_id = normalize_instance_id(str(state_value.get("instance", "")))
        except argparse.ArgumentTypeError:
            continue
        if instance_directory_name(instance_id) != runtime.name:
            continue
        try:
            microhost = int((runtime / "microhost.pid").read_text(encoding="utf-8").strip())
        except (FileNotFoundError, OSError, ValueError):
            microhost = None
        running = bool(
            microhost
            and microhost_belongs_to_runtime(microhost, runtime)
            and (runtime / "control.sock").exists()
        )
        instances.append({
            "instance": instance_id,
            "running": running,
            "session_id": state_value.get("session_id"),
            "host_workspace": state_value.get("host_workspace"),
            "microhost_pid": microhost if running else None,
            "launch": state_value.get("launch", {}),
        })
    return {"count": len(instances), "instances": instances}


def host_instance() -> dict[str, Any]:
    candidates = instances()
    if not candidates:
        raise AgentSeatError(_("host Hyprland instance not found"))
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    return next((item for item in candidates if item["instance"] == signature), candidates[0])


def microhost_pid() -> int | None:
    try:
        pid = int(MICROHOST_PID.read_text(encoding="utf-8").strip())
    except (FileNotFoundError, OSError, ValueError):
        return None
    return pid if microhost_belongs_to_runtime(pid) else None


def eye_pid() -> int | None:
    try:
        pid = int(EYE_PID.read_text(encoding="utf-8").strip())
    except (FileNotFoundError, OSError, ValueError):
        return None
    return pid if eye_belongs_to_runtime(pid) else None


def hypr_json(signature: str, command: str) -> Any:
    return json.loads(run(["hyprctl", "--instance", signature, command, "-j"]).stdout)


def host_client_for_pid(host_signature: str, pid: int) -> dict[str, Any] | None:
    clients = json.loads(run(["hyprctl", "--instance", host_signature, "clients", "-j"]).stdout)
    return next((client for client in clients if int(client.get("pid", -1)) == pid), None)


def host_snapshot(host: dict[str, Any]) -> dict[str, Any]:
    signature = str(host["instance"])
    workspace = hypr_json(signature, "activeworkspace")
    window = hypr_json(signature, "activewindow")
    cursor = hypr_json(signature, "cursorpos")
    return {
        "workspace": workspace.get("id"),
        "window": window.get("address"),
        "title": window.get("title"),
        "cursor": [cursor.get("x"), cursor.get("y")],
    }


def same_host_focus(before: dict[str, Any], after: dict[str, Any]) -> bool:
    return all(before.get(key) == after.get(key) for key in ("workspace", "window", "title"))


def host_focus_relation(before: dict[str, Any], after: dict[str, Any], outer_window: str) -> str:
    if same_host_focus(before, after):
        return "unchanged"
    if after.get("window") == outer_window:
        return "outer-focused"
    return "concurrent-host-change"


def normalize_instance_id(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,47}", value):
        raise argparse.ArgumentTypeError(
            _("instance identifier must use 1-48 letters, digits, dots, underscores, or hyphens")
        )
    return value


def instance_paths(instance_id: str) -> tuple[Path, Path]:
    normalized = normalize_instance_id(instance_id)
    directory_name = instance_directory_name(normalized)
    return INSTANCE_RUNTIME_ROOT / directory_name, INSTANCE_STATE_ROOT / directory_name


def instance_directory_name(instance_id: str) -> str:
    normalized = normalize_instance_id(instance_id)
    digest = hashlib.sha256(normalized.encode("utf-8")).hexdigest()[:24]
    return f"app-{digest}"


def instance_environment(instance_id: str) -> dict[str, str]:
    runtime, state_home = instance_paths(instance_id)
    environment = dict(os.environ)
    environment.update({
        "AGENTSEAT_INSTANCE": instance_id,
        "AGENTSEAT_RUNTIME_DIR": str(runtime),
        "AGENTSEAT_STATE_HOME": str(state_home),
    })
    return environment


def execute_for_instance(instance_id: str, argv: list[str]) -> None:
    os.execve(
        sys.executable,
        [sys.executable, str(Path(__file__).resolve()), *argv],
        instance_environment(instance_id),
    )


def launch_executable(argv: list[str]) -> str:
    """Return the real command name when argv uses env as a generic wrapper."""
    if not argv:
        return "app"
    index = 0
    if Path(argv[0]).name == "env":
        index = 1
        options_with_values = {"-u", "--unset", "-C", "--chdir", "-S", "--split-string"}
        while index < len(argv):
            value = argv[index]
            if value == "--":
                index += 1
                break
            if value in options_with_values:
                index += 2
                continue
            if value.startswith(("--unset=", "--chdir=", "--split-string=")):
                index += 1
                continue
            if value.startswith("-") or "=" in value:
                index += 1
                continue
            break
    return argv[index] if index < len(argv) else argv[0]


def allocate_instance_id(argv: list[str]) -> str:
    basename = Path(launch_executable(argv)).name.casefold()
    slug = re.sub(r"[^a-z0-9._-]+", "-", basename).strip(".-_") or "app"
    slug = slug[:24]
    for _attempt in range(16):
        candidate = f"{slug}-{uuid.uuid4().hex[:8]}"
        runtime, _state_home = instance_paths(candidate)
        if not runtime.exists():
            return candidate
    raise AgentSeatError(_("could not allocate a unique AgentSeat instance identifier"))


def launch_workspace(value: str) -> int:
    if value.casefold() == "current":
        workspace = host_snapshot(host_instance()).get("workspace")
        if isinstance(workspace, int) and workspace > 0:
            return workspace
        raise AgentSeatError(_("current host workspace is unavailable"))
    try:
        workspace = int(value)
    except ValueError as exc:
        raise AgentSeatError(_("host workspace must be 'current' or a positive integer")) from exc
    if workspace <= 0:
        raise AgentSeatError(_("host workspace must be 'current' or a positive integer"))
    return workspace


def launch_window_properties(host_workspace: int, active_workspace: int | None) -> str:
    if host_workspace <= 0:
        raise AgentSeatError(_("host workspace must be a positive integer"))
    properties = [
        "no_initial_focus true",
        "focus_on_activate false",
        "suppress_event activate activatefocus",
    ]
    if host_workspace != active_workspace:
        # Hyprland 0.56 uses snake_case rule effects. This is a one-shot
        # placement rule, not `workspace N silent`.
        # It assigns only the new outer window and does not switch the host.
        properties.insert(0, f"workspace {host_workspace}")
    return f"[{'; '.join(properties)}]"


def application_hud_position_file(argv: list[str], cwd: str | None = None) -> Path:
    executable = launch_executable(argv)
    base = Path(cwd or os.getcwd())
    resolved = Path(shutil.which(executable) or (base / executable)).resolve()
    identity = str(resolved)
    # Keep script applications distinct even when they share an interpreter.
    if resolved.name.startswith(("python", "pypy")):
        args = argv[argv.index(executable) + 1:]
        if args and args[0] == "-m" and len(args) > 1:
            identity += " module:" + args[1]
        elif args and not args[0].startswith("-"):
            identity += " script:" + str((base / args[0]).resolve())
    key = hashlib.sha256(identity.encode()).hexdigest()
    directory = CONFIG_HOME / "applications" / key
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    return directory / "hud-position.json"


def microhost_launch_command(
    launch_properties: str,
    host_scale: float,
    mode: str = "wayland",
    hud_position_file: Path | None = None,
) -> str:
    environment = {
        # This is compositor output scale, not an application zoom override.
        # Render physical pixels while preserving the Hyprland logical size.
        "AGENTSEAT_HOST_SCALE": f"{host_scale:.6g}",
        "AGENTSEAT_APPLICATION_MODE": mode,
        "AGENTSEAT_HUMAN_GRACE_MS": str(PREFERENCES["human_priority_grace_ms"]),
        "AGENTSEAT_RUNTIME_DIR": str(RUNTIME),
        "AGENTSEAT_STATE_HOME": str(STATE_HOME),
    }
    if hud_position_file is not None:
        environment["AGENTSEAT_HUD_POSITION_FILE"] = str(hud_position_file)
    assignments = " ".join(
        shlex.quote(f"{name}={value}") for name, value in environment.items()
    )
    return f"{launch_properties} env {assignments} {shlex.quote(str(RUN_MICROHOST))}"


def select_host_output_scale(
    workspaces: list[dict[str, Any]],
    monitors: list[dict[str, Any]],
    host_workspace: int,
    active_workspace: int | None,
) -> float:
    target = next((item for item in workspaces if int(item.get("id", -1)) == host_workspace), None)
    target_monitor_id = target.get("monitorID") if target else None
    target_monitor_name = target.get("monitor") if target else None
    monitor = next(
        (
            item
            for item in monitors
            if (target_monitor_id is not None and item.get("id") == target_monitor_id)
            or (target_monitor_name and item.get("name") == target_monitor_name)
        ),
        None,
    )
    if monitor is None and active_workspace is not None:
        monitor = next(
            (item for item in monitors if item.get("activeWorkspace", {}).get("id") == active_workspace),
            None,
        )
    if monitor is None:
        monitor = next((item for item in monitors if item.get("focused")), monitors[0] if monitors else None)
    try:
        return max(1.0, float(monitor.get("scale", 1.0))) if monitor else 1.0
    except (TypeError, ValueError):
        return 1.0


def physical_size_for_host(logical_size: int, host_scale: float) -> int:
    return max(1, math.ceil(logical_size * host_scale))


def load_state() -> dict[str, Any]:
    if not STATE.exists():
        return {}
    try:
        return json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(value: dict[str, Any]) -> None:
    atomic_write_private_text(STATE, json.dumps(value, ensure_ascii=False, indent=2) + "\n")


def rpc(method: str, params: dict[str, Any] | None = None) -> Any:
    """Call the resident AgentSeat daemon without spawning an intermediate CLI."""
    global RPC_SESSION_ID, RPC_CONTROL_EPOCH, RPC_WRITE_LEASE
    payload = dict(params or {})
    if method in WRITE_METHODS:
        if RPC_SESSION_ID is None:
            value = load_state().get("session_id")
            if not isinstance(value, str) or not value:
                raise AgentSeatError("SESSION_REQUIRED: no pinned session is available for this write")
            RPC_SESSION_ID = value
        payload.setdefault("session_id", RPC_SESSION_ID)
        payload.setdefault("controller_id", RPC_CONTROLLER_ID)
        if method.startswith(("pointer.", "keyboard.", "a11y.")) or method in {"window.focus", "window.move", "window.resize", "window.close"}:
            if RPC_CONTROL_EPOCH is None:
                heartbeat = rpc("session.heartbeat")
                if heartbeat.get("session_id") != RPC_SESSION_ID:
                    raise AgentSeatError("SESSION_MISMATCH: session changed before input")
                RPC_CONTROL_EPOCH = int(heartbeat.get("control_epoch", 0))
                if "write_control" in heartbeat:
                    RPC_WRITE_LEASE = rpc("control.acquire", {"ttl_ms": 10000})
                    RPC_CONTROL_EPOCH = RPC_WRITE_LEASE["control_epoch"]
            payload.setdefault("control_epoch", RPC_CONTROL_EPOCH)
            if RPC_WRITE_LEASE:
                payload.setdefault("lease_id", RPC_WRITE_LEASE["lease_id"])
        # Monotonic IDs make receipt eviction fail closed for old requests.
        # Generate after any recursive heartbeat/acquire call.
        payload.setdefault("request_id", time.monotonic_ns())
    request_id = uuid.uuid4().hex
    request = {
        "jsonrpc": "2.0",
        "id": request_id,
        "method": method,
        "params": payload,
    }
    encoded = (json.dumps(request, ensure_ascii=False, separators=(",", ":")) + "\n").encode()
    received = bytearray()
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(15)
            client.connect(str(CONTROL_SOCKET))
            client.sendall(encoded)
            while b"\n" not in received:
                block = client.recv(65_536)
                if not block:
                    break
                received.extend(block)
                if len(received) > RPC_LIMIT:
                    raise AgentSeatError(_("AgentSeat daemon response exceeds 1 MiB"))
    except OSError as exc:
        detail = _("cannot reach AgentSeat daemon: {error}").format(error=exc)
        if method in WRITE_METHODS:
            detail += f"; controller_id={payload['controller_id']}; request_id={payload['request_id']}; query receipt before retry"
        raise AgentSeatError(detail) from exc
    if not received:
        raise AgentSeatError(_("AgentSeat daemon returned no response"))
    try:
        response = json.loads(bytes(received).split(b"\n", 1)[0])
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise AgentSeatError(_("invalid AgentSeat daemon response: {error}").format(error=exc)) from exc
    if response.get("id") != request_id:
        raise AgentSeatError(_("AgentSeat daemon response ID mismatch"))
    if "error" in response:
        error = response["error"]
        details = error.get("data", {})
        code = details.get("kind", error.get("code", "AGENTSEAT_ERROR"))
        message = error.get("message", _("AgentSeat daemon rejected the request"))
        raise AgentSeatError(f"{code}: {message}")
    return response.get("result")


def wait_for(predicate: Any, timeout: float, message: str) -> Any:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(0.1)
    raise AgentSeatError(message)


def startup_window() -> dict[str, Any] | None:
    # The first mapped surface may be a splash or an application-owned popup.
    # Wait for the micro-host's real focus decision instead of forcing focus on
    # whichever window was enumerated first.
    candidates = [window for window in rpc("window.list")
                  if window.get("focused") and not window.get("popup")
                  and window.get("mapped") and not window.get("hidden")]
    return candidates[0] if len(candidates) == 1 else None


def agent_daemon_pids() -> list[int]:
    result: list[int] = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        if daemon_belongs_to_runtime(pid):
            result.append(pid)
    return result


def normalize_argv(values: list[str]) -> list[str]:
    argv = list(values)
    if argv and argv[0] == "--":
        argv.pop(0)
    if not argv or any(not value or "\0" in value for value in argv):
        raise AgentSeatError(_("run requires a non-empty command after --"))
    return argv


def normalized_cwd(value: str | None) -> str:
    path = Path.cwd() if value is None else Path(value).expanduser()
    path = path.resolve()
    if not path.is_dir():
        raise AgentSeatError(_("working directory does not exist: {path}").format(path=path))
    return str(path)


INPUT_ENVIRONMENT_NAMES = ('GTK_IM_MODULE', 'QT_IM_MODULE', 'QT_IM_MODULES', 'XMODIFIERS', 'XCOMPOSEFILE', 'XCOMPOSECACHE', 'IBUS_ADDRESS', 'IBUS_ADDRESS_FILE', 'IBUS_USE_PORTAL', 'DBUS_SESSION_BUS_ADDRESS', 'LANG', 'LANGUAGE', 'LC_ALL', 'LC_CTYPE', 'XKB_DEFAULT_RULES', 'XKB_DEFAULT_MODEL', 'XKB_DEFAULT_LAYOUT', 'XKB_DEFAULT_VARIANT', 'XKB_DEFAULT_OPTIONS')


def capture_input_environment() -> dict[str, str | None]:
    # hyprctl exec inherits the compositor's launch-time environment. Carry
    # this caller's current input settings through the private launch file.
    values = {name: os.environ.get(name) for name in INPUT_ENVIRONMENT_NAMES}
    modules = (values.get("GTK_IM_MODULE"), values.get("QT_IM_MODULE"), values.get("XMODIFIERS"))
    if any(value in {"ibus", "@im=ibus"} for value in modules):
        # GTK accepts IBUS_ADDRESS; Qt's IBus module discovers the original
        # daemon through its address file. Resolve both before changing DISPLAY.
        try:
            result = subprocess.run(["/usr/bin/python3", "-c",
                "import gi,json; gi.require_version('IBus','1.0'); from gi.repository import IBus; "
                "print(json.dumps({'IBUS_ADDRESS':IBus.get_address(),'IBUS_ADDRESS_FILE':IBus.get_socket_path()}))"],
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                text=True, timeout=2, check=False)
            endpoints = json.loads(result.stdout) if result.returncode == 0 else {}
            for name in ("IBUS_ADDRESS", "IBUS_ADDRESS_FILE"):
                value = endpoints.get(name)
                if not values.get(name) and isinstance(value, str) and value and len(value) <= 4096:
                    values[name] = value
        except (OSError, subprocess.TimeoutExpired, ValueError, AttributeError):
            pass
    return values


def write_launch_spec(
    argv: list[str],
    mode: str,
    cwd: str,
    *,
    private_dbus: bool = False,
    a11y: bool = False,
    ime: str = "simple",
) -> None:
    if mode not in {"wayland", "x11"}:
        raise AgentSeatError(_("unsupported display mode: {mode}").format(mode=mode))
    payload = {
        "version": 1,
        "argv": argv,
        "mode": mode,
        "cwd": cwd,
        "private_dbus": private_dbus,
        "input_environment": capture_input_environment(),
    }
    if a11y:
        payload["a11y"] = True
    if ime != "simple":
        payload["ime"] = ime
    atomic_write_private_text(
        LAUNCH_SPEC,
        json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n",
    )


def load_application_env() -> dict[str, str] | None:
    try:
        value = json.loads(APPLICATION_ENV.read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return None
    wayland_display = value.get("wayland_display")
    if not isinstance(wayland_display, str) or not wayland_display:
        return None
    display = value.get("display")
    return {
        "wayland_display": wayland_display,
        "display": display if isinstance(display, str) else "",
    }


def refresh_outer_geometry(state_value: dict[str, Any] | None = None) -> dict[str, Any]:
    """Read geometry reported by the private compositor; never query or write host geometry."""
    current = dict(state_value if state_value is not None else load_state())
    if not current:
        return current
    geometry = rpc("session.heartbeat").get("output")
    if not geometry:
        return current
    current["application_coordinate_size"] = [geometry["width"], geometry["height"]]
    if current.get("launch", {}).get("mode") == "x11":
        host_scale = float(current.get("host_output_scale", 1.0))
        current["viewport_logical_size"] = [
            round(geometry[key] / host_scale) for key in ("pixel_width", "pixel_height")
        ]
    else:
        current["viewport_logical_size"] = [geometry["width"], geometry["height"]]
    current["physical_buffer_size"] = [geometry["pixel_width"], geometry["pixel_height"]]
    current["render_scale"] = geometry["scale"]
    current["geometry_version"] = geometry["geometry_version"]
    return current


def legacy_command(preset: str) -> tuple[list[str], str, str | None]:
    if preset == "onlyoffice":
        return ["/usr/bin/onlyoffice-desktopeditors"], "wayland", "onlyoffice-native-wayland"
    raise AgentSeatError(_("unknown legacy preset: {preset}").format(preset=preset))


def sync_window_tree(*, focus_newest: bool = True) -> list[dict[str, Any]]:
    """Read the compositor's mapped application windows without implicit writes."""
    return rpc("window.list")


def start_application(
    argv: list[str],
    *,
    mode: str,
    cwd: str,
    host_workspace: int = 1,
    legacy_preset: str | None = None,
    compat_type: str | None = None,
    private_dbus: bool = False,
    a11y: bool = False,
    ime: str = "simple",
) -> dict[str, Any]:
    existing = microhost_pid()
    if existing and CONTROL_SOCKET.exists():
        current = load_state()
        current_launch = current.get("launch", {})
        requested_launch = {
            "argv": argv,
            "mode": mode,
            "cwd": cwd,
            "private_dbus": private_dbus,
            "a11y": a11y,
            "ime": ime,
        }
        if legacy_preset and current.get("preset") == legacy_preset:
            return status()
        if all(
            current_launch.get(key, "simple" if key == "ime" else False if key in {"private_dbus", "a11y"} else None) == value
            for key, value in requested_launch.items()
        ):
            return status()
        raise AgentSeatError(
            _("AgentSeat is already running another application; stop it before launching a different command")
        )
    if existing:
        raise AgentSeatError(_("an unmanaged AgentSeat micro-host is already running; run agentseat stop first"))

    host = host_instance()
    before = host_snapshot(host)
    signature = str(host["instance"])
    host_scale = select_host_output_scale(
        hypr_json(signature, "workspaces"),
        hypr_json(signature, "monitors"),
        host_workspace,
        before.get("workspace"),
    )
    launch_properties = launch_window_properties(host_workspace, before.get("workspace"))
    ensure_runtime_storage()
    for stale in (MICROHOST_PID, EYE_PID, APPLICATION_ENV, MICROHOST_READY):
        try:
            stale.unlink()
        except FileNotFoundError:
            pass
    write_launch_spec(argv, mode, cwd, private_dbus=private_dbus, **({"a11y": True} if a11y else {}), **({"ime": ime} if ime != "simple" else {}))
    run([
        "hyprctl", "--instance", str(host["instance"]), "dispatch", "exec",
        microhost_launch_command(launch_properties, host_scale, mode, application_hud_position_file(argv, cwd)),
    ])
    microhost = wait_for(microhost_pid, 12, _("AgentSeat micro-host did not appear"))
    outer = wait_for(
        lambda: host_client_for_pid(str(host["instance"]), int(microhost)),
        8,
        _("outer AgentSeat window did not appear"),
    )
    if int(outer.get("workspace", {}).get("id", -1)) != host_workspace:
        raise AgentSeatError(
            _("AgentSeat outer window did not map on requested workspace {workspace}").format(
                workspace=host_workspace
            )
        )
    if not NATIVE_DAEMON.is_file() or not os.access(NATIVE_DAEMON, os.X_OK):
        raise AgentSeatError(
            _("native AgentSeat daemon is missing or not executable: {path}").format(path=NATIVE_DAEMON)
        )
    app_environment = wait_for(
        load_application_env, 8, _("AgentSeat application environment receipt did not appear")
    )
    wait_for(MICROHOST_READY.exists, 12, _("application did not map in the AgentSeat micro-host"))
    daemon_log = open_private_log(LOG_DIR / "daemon.log")
    env = dict(os.environ)
    env.update({
        "XDG_RUNTIME_DIR": str(USER_RUNTIME_DIR),
        "WAYLAND_DISPLAY": app_environment["wayland_display"],
        "AGENTSEAT_LANGUAGE": CURRENT_LANGUAGE,
    })
    if CURRENT_LOCALE_DIR:
        env["AGENTSEAT_LOCALE_DIR"] = str(CURRENT_LOCALE_DIR)
    global RPC_SESSION_ID, RPC_CONTROL_EPOCH
    session_id = uuid.uuid4().hex
    RPC_SESSION_ID = session_id
    RPC_CONTROL_EPOCH = None
    daemon_argv = [
        str(NATIVE_DAEMON),
        "--socket", str(CONTROL_SOCKET),
        "--activity-socket", str(ACTIVITY_SOCKET),
        "--session-id", session_id,
        "--human-grace-ms", str(PREFERENCES["human_priority_grace_ms"]),
        "--workspace", str(host_workspace),
        "--seat-id", "agent:agentseat",
        "--seat-name", "AgentSeat Agent",
        "--app-id", Path(argv[0]).name,
        "--window-title", Path(argv[0]).name,
        "--width", str(int(outer.get("size", [1280, 720])[0])),
        "--height", str(int(outer.get("size", [1280, 720])[1])),
    ]
    if mode == "x11":
        daemon_argv.append("--xwayland")
    daemon = subprocess.Popen(
        daemon_argv,
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=daemon_log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    wait_for(CONTROL_SOCKET.exists, 8, _("AgentSeat daemon socket did not appear"))
    rpc("seat.create", {"workspace": host_workspace})
    window = wait_for(startup_window, 12, _("application window did not appear"))
    rpc("window.lease", {"window_id": str(window["id"])})
    release_write_control()

    after = host_snapshot(host)
    relation = host_focus_relation(before, after, str(outer["address"]))
    restored_outer_focus = False
    if relation == "outer-focused" and before.get("window"):
        run([
            "hyprctl", "--instance", str(host["instance"]), "dispatch", "focuswindow",
            f"address:{before['window']}",
        ], check=False)
        restored_outer_focus = True
        after = host_snapshot(host)
    if relation == "outer-focused" and not same_host_focus(before, after):
        raise AgentSeatError(
            _("host focus isolation failed: before={before!r} after={after!r}").format(
                before=before, after=after
            )
        )
    state_value = {
        "instance": SELECTED_INSTANCE or "default",
        "session_id": session_id,
        "launch": {
            "argv": argv,
            "mode": mode,
            "cwd": cwd,
            "private_dbus": private_dbus,
            "a11y": a11y,
            "ime": ime,
        },
        "host_instance": host["instance"],
        "backend": "cage-microhost",
        "microhost_pid": microhost,
        "outer_window": outer["address"],
        "host_workspace": host_workspace,
        "host_output_scale": host_scale,
        "buffer_scale": host_scale,
        "render_scale": host_scale,
        "physical_pixel_layout": True,
        "viewport_logical_size": list(outer.get("size", [1280, 720])),
        "physical_buffer_size": [
            physical_size_for_host(int(value), host_scale)
            for value in outer.get("size", [1280, 720])
        ],
        "wayland_display": app_environment["wayland_display"],
        "x_display": app_environment["display"],
        "daemon_pid": daemon.pid,
        "window_id": str(window["id"]),
        "host_snapshot": before,
        "host_launch_receipt": {
            "before": before,
            "after": after,
            "relation": relation,
            "restored_outer_focus": restored_outer_focus,
        },
    }
    if legacy_preset:
        state_value["preset"] = legacy_preset
    if compat_type:
        state_value["compat_type"] = compat_type
    save_state(state_value)
    hud = start_hud() if PREFERENCES["eye_hud"] else {"running": False, "disabled_by_config": True}
    state_value["eye_hud"] = hud
    save_state(state_value)
    return status()


def start_safely(*args: Any, **kwargs: Any) -> dict[str, Any]:
    with lifecycle_lock():
        preexisting_session = bool(microhost_pid() or agent_daemon_pids())
        try:
            return start_application(*args, **kwargs)
        except Exception as exc:
            if not preexisting_session:
                try:
                    _stop_unlocked()
                except (AgentSeatError, OSError, TypeError, ValueError) as cleanup_error:
                    exc.add_note(f"AgentSeat launch cleanup also failed: {cleanup_error}")
            raise


def status() -> dict[str, Any]:
    state_value = load_state()
    microhost = microhost_pid()
    live = bool(microhost and CONTROL_SOCKET.exists())
    if live:
        state_value = refresh_outer_geometry(state_value)
    result: dict[str, Any] = {"protocol_version": 2, "running": live, "state": state_value}
    result["eye_hud"] = {
        "running": eye_pid() is not None,
        "pid": eye_pid(),
        "enabled_by_config": bool(PREFERENCES["eye_hud"]),
        "scope": "private-microhost",
        "default_corner": "bottom-right",
    }
    if live:
        windows = sync_window_tree()
        result["seat"] = rpc("seat.status")
        result["windows"] = windows
        result["application_state"] = "windowed" if windows else "background"
        host = host_instance()
        result["host_now"] = host_snapshot(host)
        matches_start = same_host_focus(state_value.get("host_snapshot", {}), result["host_now"])
        result["host_matches_start_snapshot"] = matches_start
        result["host_focus_unchanged"] = matches_start
    return result


def session_heartbeat(expected_session_id: str | None = None) -> dict[str, Any]:
    """Verify one live session without changing its window focus or input state."""
    state_value = load_state()
    microhost = microhost_pid()
    if not microhost or not CONTROL_SOCKET.exists():
        raise AgentSeatError(_("AgentSeat is not running"))
    state_value = refresh_outer_geometry(state_value)
    daemon = rpc("session.heartbeat")
    session_id = daemon.get("session_id") if isinstance(daemon, dict) else None
    if not isinstance(session_id, str) or not session_id:
        raise AgentSeatError(_("AgentSeat daemon returned an invalid session identity"))
    persisted_session_id = state_value.get("session_id")
    if isinstance(persisted_session_id, str) and persisted_session_id != session_id:
        raise AgentSeatError(
            _("AgentSeat runtime state belongs to a different session: expected {expected}, got {actual}").format(
                expected=persisted_session_id,
                actual=session_id,
            )
        )
    if expected_session_id and expected_session_id != session_id:
        raise AgentSeatError(
            _("AgentSeat session changed: expected {expected}, got {actual}").format(
                expected=expected_session_id,
                actual=session_id,
            )
        )
    daemon_pid = daemon.get("daemon_pid")
    persisted_daemon_pid = state_value.get("daemon_pid")
    if persisted_daemon_pid is not None and daemon_pid != persisted_daemon_pid:
        raise AgentSeatError(_("AgentSeat runtime state does not match the connected daemon"))
    windows = rpc("window.list") if daemon.get("seat_created") else []
    healthy = bool(daemon.get("seat_created"))
    if not healthy:
        raise AgentSeatError(_("AgentSeat session has no usable application window"))
    return {
        "healthy": True,
        "session_id": session_id,
        "reconnectable": True,
        "connection": "fresh-unix-socket-per-request",
        "microhost_pid": microhost,
        "application_windows": len(windows),
        "application_state": "windowed" if windows else "background",
        "window_ready": bool(windows),
        "state_matches_daemon": True,
        "daemon": daemon,
    }


def watch_session(*, interval: float, count: int, expected_session_id: str | None = None) -> dict[str, Any]:
    """Continuously reconnect to one session and stream compact JSON heartbeats."""
    if not math.isfinite(interval) or interval < 0.1 or interval > 3600:
        raise AgentSeatError(_("watch interval must be between 0.1 and 3600 seconds"))
    if count < 0:
        raise AgentSeatError(_("watch count must be zero or a positive integer"))
    sequence = 0
    pinned_session_id = expected_session_id
    last_sample: dict[str, Any] = {}
    while count == 0 or sequence < count:
        heartbeat = session_heartbeat(pinned_session_id)
        if pinned_session_id is None:
            pinned_session_id = heartbeat["session_id"]
        sequence += 1
        daemon = heartbeat["daemon"]
        collaboration = daemon.get("collaboration", {})
        last_sample = {
            "sequence": sequence,
            "observed_unix_ms": time.time_ns() // 1_000_000,
            "healthy": True,
            "session_id": heartbeat["session_id"],
            "uptime_ms": daemon.get("uptime_ms"),
            "request_count": daemon.get("request_count"),
            "daemon_pid": daemon.get("daemon_pid"),
            "microhost_pid": heartbeat["microhost_pid"],
            "application_windows": heartbeat["application_windows"],
            "application_state": heartbeat.get("application_state", "windowed" if heartbeat["application_windows"] else "background"),
            "window_ready": heartbeat.get("window_ready", bool(heartbeat["application_windows"])),
            "seat_paused": daemon.get("seat_paused"),
            "agent_allowed": collaboration.get("agent_allowed"),
            "human_active": collaboration.get("human_active"),
        }
        print(json.dumps(last_sample, ensure_ascii=False, separators=(",", ":")), flush=True)
        if count == 0 or sequence < count:
            time.sleep(interval)
    return last_sample


def start_hud() -> dict[str, Any]:
    existing = eye_pid()
    if existing:
        return {"running": True, "pid": existing, "connected": CONTROL_SOCKET.exists()}
    if not EYE_BINARY.is_file() or not os.access(EYE_BINARY, os.X_OK):
        raise AgentSeatError(
            _("native AgentSeat eye HUD is missing or not executable: {path}").format(path=EYE_BINARY)
        )
    state_value = load_state()
    if not microhost_pid() or not CONTROL_SOCKET.exists():
        raise AgentSeatError(_("AgentSeat must be running before its embedded AI head can start"))
    wayland_display = state_value.get("wayland_display")
    if not isinstance(wayland_display, str) or not wayland_display:
        application_env = load_application_env()
        wayland_display = application_env["wayland_display"] if application_env else None
    if not wayland_display:
        raise AgentSeatError(_("AgentSeat private Wayland display is unavailable"))
    environment = dict(os.environ)
    environment.update({
        "XDG_RUNTIME_DIR": str(USER_RUNTIME_DIR),
        "WAYLAND_DISPLAY": wayland_display,
        "GDK_BACKEND": "wayland",
        # The HUD is vector text plus one tiny Cairo head. Inheriting the host's
        # GL renderer loads a full software-GL stack inside the pixman
        # micro-host for no visual benefit.
        "GSK_RENDERER": "cairo",
        "AGENTSEAT_SESSION_ID": str(state_value.get("session_id", "")),
        "AGENTSEAT_LANGUAGE": CURRENT_LANGUAGE,
        # Only the owned HUD needs logical sizing in the physical X11 scene.
        "AGENTSEAT_HUD_SCALE": str(state_value.get("host_output_scale", 1.0)
            if state_value.get("launch", {}).get("mode") == "x11" else 1.0),
    })
    if CURRENT_LOCALE_DIR:
        environment["AGENTSEAT_LOCALE_DIR"] = str(CURRENT_LOCALE_DIR)
    environment.pop("DISPLAY", None)
    environment.pop("HYPRLAND_INSTANCE_SIGNATURE", None)
    eye_log = open_private_log(LOG_DIR / "eye.log")
    eye = subprocess.Popen(
        [str(EYE_BINARY), "--socket", str(CONTROL_SOCKET), "--embedded"],
        env=environment,
        stdin=subprocess.DEVNULL,
        stdout=eye_log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    EYE_PID.write_text(f"{eye.pid}\n", encoding="utf-8")
    os.chmod(EYE_PID, 0o600)
    time.sleep(0.35)
    if eye.poll() is not None:
        raise AgentSeatError(
            _("AgentSeat eye HUD exited during startup; inspect {path}").format(path=LOG_DIR / "eye.log")
        )
    return {
        "running": True,
        "pid": eye.pid,
        "connected": CONTROL_SOCKET.exists(),
        "enabled_by_config": bool(PREFERENCES["eye_hud"]),
        "scope": "private-microhost",
        "default_corner": "bottom-right",
    }


def stop_hud() -> dict[str, Any]:
    hud_pid = eye_pid()
    if hud_pid:
        try:
            os.kill(hud_pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        wait_for(lambda: eye_pid() is None, 5, _("AgentSeat eye HUD did not stop"))
    try:
        EYE_PID.unlink()
    except FileNotFoundError:
        pass
    return {"running": False}


def _stop_unlocked() -> dict[str, Any]:
    state_value = load_state()
    # Keep the verified PID before asking the daemon to shut down. The daemon or
    # application can remove the runtime PID file before the outer micro-host has
    # actually exited; re-reading only the file would then orphan the host window.
    owned_microhost = microhost_pid()
    if not owned_microhost and state_value.get("microhost_pid"):
        persisted_microhost = int(state_value["microhost_pid"])
        if microhost_belongs_to_runtime(persisted_microhost):
            owned_microhost = persisted_microhost
    stop_hud()
    daemon_pids = set(agent_daemon_pids())
    if state_value.get("daemon_pid"):
        persisted_daemon_pid = int(state_value["daemon_pid"])
        if daemon_belongs_to_runtime(persisted_daemon_pid):
            daemon_pids.add(persisted_daemon_pid)
    if CONTROL_SOCKET.exists():
        try:
            rpc("shutdown")
        except AgentSeatError:
            pass
    if daemon_pids:
        wait_for(
            lambda: all(not Path(f"/proc/{pid}").exists() for pid in daemon_pids),
            5,
            _("daemon did not stop"),
        )
    for socket_path in (CONTROL_SOCKET, ACTIVITY_SOCKET):
        if socket_path.exists():
            socket_stat = socket_path.lstat()
            if not stat.S_ISSOCK(socket_stat.st_mode) or socket_stat.st_uid != os.getuid():
                raise AgentSeatError(
                    _("refusing to remove an unexpected AgentSeat socket: {path}").format(path=socket_path)
                )
            socket_path.unlink()
    if owned_microhost and microhost_belongs_to_runtime(owned_microhost):
        try:
            os.kill(owned_microhost, signal.SIGTERM)
        except ProcessLookupError:
            pass
        wait_for(
            lambda: not microhost_belongs_to_runtime(owned_microhost),
            8,
            _("AgentSeat micro-host did not stop"),
        )
    try:
        STATE.unlink()
    except FileNotFoundError:
        pass
    for transient in (LAUNCH_SPEC, APPLICATION_ENV, MICROHOST_PID, MICROHOST_READY, EYE_PID):
        try:
            transient.unlink()
        except FileNotFoundError:
            pass
    return {"stopped": True}


def stop() -> dict[str, Any]:
    with lifecycle_lock():
        return _stop_unlocked()


def release_write_control() -> dict[str, Any]:
    global RPC_WRITE_LEASE, RPC_CONTROL_EPOCH
    lease = RPC_WRITE_LEASE or rpc("control.status")
    if lease.get("controller_id") != RPC_CONTROLLER_ID or not lease.get("lease_id"):
        return {"released": False}
    result = rpc("control.release", {"lease_id": lease["lease_id"]})
    RPC_WRITE_LEASE = None
    RPC_CONTROL_EPOCH = None
    return result


def pause_seat() -> dict[str, Any]:
    result = rpc("seat.pause")
    deadline = time.monotonic() + 3
    while True:
        heartbeat = rpc("session.heartbeat")
        if heartbeat.get("session_id") != RPC_SESSION_ID:
            raise AgentSeatError("SESSION_MISMATCH: session changed while waiting for pause")
        if "gate_epoch" not in heartbeat:
            return result  # Existing v1 sessions have no final-delivery acknowledgement.
        if not heartbeat["gate_allowed"] and heartbeat["gate_epoch"] >= heartbeat["control_epoch"]:
            return {**result, "compositor_acknowledged": True}
        if time.monotonic() >= deadline:
            raise AgentSeatError("PAUSE_UNCONFIRMED: compositor has not acknowledged the input gate")
        time.sleep(0.01)


def window_action(method: str, params: dict[str, Any]) -> dict[str, Any]:
    result = rpc(method, params)
    if "operation_id" not in result:
        return result
    operation_id = result["operation_id"]
    deadline = time.monotonic() + 4
    while result.get("execution") == "running" and time.monotonic() < deadline:
        time.sleep(.01)
        result = rpc("operation.get", {"operation_id": operation_id})
    if result.get("execution") != "finished":
        raise AgentSeatError(f"WINDOW_CHANGE_UNCONFIRMED: operation_id={operation_id}; {result.get('execution')}")
    return result


def pointer_click(button: int) -> Any:
    sync_window_tree()
    return rpc("pointer.click", {"button": button})


def resolve_ime(choice: str, private_dbus: bool = False) -> str:
    if choice == "desktop" and private_dbus:
        raise AgentSeatError("--ime desktop requires the desktop session bus; use --ime fcitx5 with --private-dbus")
    if choice != "auto":
        return choice
    # Attach only a service selected by the caller, including mixed toolkit
    # choices. A running daemon alone is not the user's engine preference.
    modules = [os.environ.get(name, "") for name in ("GTK_IM_MODULE", "QT_IM_MODULE", "XMODIFIERS")]
    modules.extend(os.environ.get("QT_IM_MODULES", "").split(";"))
    if not any(value in {"fcitx", "fcitx5", "@im=fcitx"} for value in modules):
        return "inherit"
    remote = Path("/usr/bin/fcitx5-remote")
    if not remote.is_file() or not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return "inherit"
    try:
        probe = subprocess.run([str(remote), "--check"], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return "inherit"
    return ("fcitx5" if private_dbus else "desktop") if probe.returncode == 0 else "inherit"


def type_text(text: str, *, keys: bool = False) -> dict[str, Any]:
    # IME sessions paste so the engine cannot rewrite text; `keys` forces key
    # events for canvases, games and terminals that ignore paste.
    if not keys and load_state().get("launch", {}).get("ime") in {"fcitx5", "desktop", "inherit"}:
        return private_unicode_paste(text)
    result = rpc("keyboard.type", {"text": text})
    # A pre-upgrade daemon returns the legacy synchronous result.
    if "operation_id" not in result:
        return result
    operation_id = result["operation_id"]
    origin = {key: result[key] for key in ("request_id", "request_controller_id") if key in result}
    deadline = time.monotonic() + 185
    renew_at = time.monotonic() + 2
    try:
        while result.get("execution") == "running":
            if time.monotonic() >= deadline:
                raise AgentSeatError("OPERATION_TIMEOUT: query the operation before any retry")
            time.sleep(0.025)
            if RPC_WRITE_LEASE and time.monotonic() >= renew_at:
                rpc("control.renew", {"lease_id": RPC_WRITE_LEASE["lease_id"], "ttl_ms": 10000})
                renew_at = time.monotonic() + 2
            result = rpc("operation.get", {"operation_id": operation_id})
    except (KeyboardInterrupt, AgentSeatError) as exc:
        try:
            rpc("operation.cancel", {"operation_id": operation_id})
        except AgentSeatError:
            pass
        if isinstance(exc, AgentSeatError):
            raise AgentSeatError(
                f"OPERATION_UNCONFIRMED: operation_id={operation_id}; {exc}; "
                "observe before continuing"
            ) from exc
        raise
    if result.get("execution") != "finished":
        raise AgentSeatError(
            f"INPUT_INTERRUPTED: {result.get('execution')}; "
            f"submitted={result.get('submitted')}/{result.get('total')}; "
            f"operation_id={operation_id}; observe before continuing"
        )
    return {**result, **origin, "typed": result["submitted"]}


def pointer_move(x: float, y: float) -> Any:
    sync_window_tree()
    return rpc("pointer.move_absolute", {"x": x, "y": y})


def pointer_scroll(axis: str, value120: int) -> Any:
    return rpc("pointer.scroll", {"axis": axis, "value120": value120})


def keyboard_key(keycode: int, pressed: bool) -> Any:
    sync_window_tree()
    return rpc("keyboard.key", {"keycode": keycode, "pressed": pressed})


PASTE_CHUNK_CODEPOINTS = 256


def paste_chunks(text: str, limit: int = PASTE_CHUNK_CODEPOINTS) -> list[str]:
    """Split text into bounded pastes, preferring a line or word boundary."""
    chunks: list[str] = []
    while len(text) > limit:
        window = text[:limit]
        cut = max(window.rfind("\n"), window.rfind(" "))
        cut = cut + 1 if cut >= limit // 2 else limit
        chunks.append(text[:cut])
        text = text[cut:]
    if text:
        chunks.append(text)
    return chunks


def paste_once(text: str) -> dict[str, Any]:
    result = rpc("keyboard.paste", {"text": text})
    operation_id = result["operation_id"]
    origin = {k: result[k] for k in ("request_id", "request_controller_id") if k in result}
    deadline = time.monotonic() + 7
    renew_at = time.monotonic() + 2
    try:
        while result.get("execution") == "running":
            if time.monotonic() >= deadline:
                raise AgentSeatError("OPERATION_TIMEOUT: paste transfer was not confirmed")
            time.sleep(0.025)
            if RPC_WRITE_LEASE and time.monotonic() >= renew_at:
                rpc("control.renew", {"lease_id": RPC_WRITE_LEASE["lease_id"], "ttl_ms": 10000})
                renew_at = time.monotonic() + 2
            result = rpc("operation.get", {"operation_id": operation_id})
    except (KeyboardInterrupt, AgentSeatError) as exc:
        try:
            rpc("operation.cancel", {"operation_id": operation_id})
        except AgentSeatError:
            pass
        if isinstance(exc, AgentSeatError):
            raise AgentSeatError(f"OPERATION_UNCONFIRMED: operation_id={operation_id}; {exc}") from exc
        raise
    if result.get("execution") != "finished":
        raise AgentSeatError(f"INPUT_INTERRUPTED: {result.get('execution')}; operation_id={operation_id}")
    return {**result, **origin}


def private_unicode_paste(text: str) -> dict[str, Any]:
    """Native, lease-guarded paste; receipt confirms transport only.

    Long text is pasted in bounded chunks so pause, human takeover or lease
    loss stops the remaining text instead of delivering it in one transfer.
    """
    chunks = paste_chunks(text)
    transferred = 0
    operation_ids: list[str] = []
    result: dict[str, Any] = {}
    for index, chunk in enumerate(chunks):
        try:
            result = paste_once(chunk)
        except AgentSeatError as exc:
            raise AgentSeatError(
                f"{exc}; pasted_chunks={index}/{len(chunks)}; "
                f"transferred_codepoints={transferred}/{len(text)}; observe before any retry"
            ) from exc
        transferred += len(chunk)
        operation_ids.append(result["operation_id"])
    return {**result, "lane": "private-wayland-clipboard", "chunks": len(chunks),
            "operation_ids": operation_ids, "transferred_codepoints": transferred}


def safe_capture_path(path: Path) -> Path:
    candidate = path.expanduser()
    if not candidate.is_absolute() or candidate.suffix.casefold() != ".png":
        raise AgentSeatError(_("capture output must be an absolute .png path"))
    try:
        parent = candidate.parent.resolve(strict=True)
    except OSError as exc:
        raise AgentSeatError(_("capture output parent is unavailable: {error}").format(error=exc)) from exc
    if not parent.is_dir() or parent.stat().st_uid != os.getuid():
        raise AgentSeatError(_("capture output parent must be a directory owned by the current user"))
    output = parent / candidate.name
    if output.is_symlink():
        raise AgentSeatError(_("capture output cannot be a symbolic link"))
    if output.exists() and (not output.is_file() or output.stat().st_uid != os.getuid()):
        raise AgentSeatError(_("existing capture output must be a regular file owned by the current user"))
    return output


def observe(path: str | None) -> dict[str, Any]:
    state_value = load_state()
    windows = sync_window_tree()
    seat_status = rpc("seat.status")
    focused_id = str(seat_status["seat"].get("focused_window") or state_value.get("window_id") or "")
    window = next((item for item in windows if str(item["id"]) == focused_id), windows[0] if windows else None)
    if not window:
        raise AgentSeatError(_("no leased application window is available"))
    ensure_private_directory(EVIDENCE)
    output = safe_capture_path(Path(path) if path else EVIDENCE / f"agentseat-{int(time.time())}.png")
    temporary = output.with_name(f".{output.name}.{uuid.uuid4().hex}.tmp.png")
    frame = rpc("capture.submit")
    deadline = time.monotonic() + 5
    while frame["status"] in {"pending", "encoding"}:
        if time.monotonic() >= deadline:
            raise AgentSeatError("FRAME_UNCONFIRMED: capture receipt remains pending")
        time.sleep(0.01)
        frame = rpc("capture.get", {"frame_id": frame["frame_id"]})
    if frame["status"] != "finished":
        raise AgentSeatError(f"CAPTURE_FAILED: {frame.get('error')}")
    try:
        source = Path(frame["path"])
        if source.parent != CONTROL_SOCKET.parent or source.is_symlink():
            raise AgentSeatError("invalid private frame location")
        with source.open("rb") as incoming, temporary.open("xb") as outgoing:
            os.chmod(temporary, 0o600)
            shutil.copyfileobj(incoming, outgoing)
        temporary.replace(output)
    finally:
        temporary.unlink(missing_ok=True)
    return {
        "path": str(output), "backend": "wlr-screencopy", "window": window,
        "capture": {"backend": "native-wlr-screencopy", "scope": "single-app-output", **frame},
        "capture_passes": 1, "settle_ms": 0,
        # Pass to wait-change --since so a change after this frame is never missed.
        "content_serial": frame.get("content_serial"),
    }


WAIT_CHANGE_DEFAULT_MIN_EXTENT = 5


def wait_for_change(
    since: int | None = None,
    timeout_ms: int = 5000,
    region: tuple[float, float, float, float] | None = None,
    min_area_ratio: float = 0.0,
    settle_ms: int = 0,
    min_extent: float = WAIT_CHANGE_DEFAULT_MIN_EXTENT,
) -> dict[str, Any]:
    """Wait for damaged application output, read-only and bounded.

    A change qualifies when its damage box is at least min_extent logical
    pixels wide and tall, covers min_area_ratio of the output and intersects
    region (normalized x, y, width, height). Thin caret blinks are ignored.
    """
    if not 0 <= timeout_ms <= 60000:
        raise AgentSeatError("INVALID_PARAMS: --timeout-ms must be from 0 to 60000")
    if not 0 <= settle_ms <= 10000:
        raise AgentSeatError("INVALID_PARAMS: --settle-ms must be from 0 to 10000")
    if not 0 <= min_area_ratio <= 1:
        raise AgentSeatError("INVALID_PARAMS: --min-area-ratio must be from 0 to 1")
    if not 0 <= min_extent <= 1000:
        raise AgentSeatError("INVALID_PARAMS: --min-extent must be from 0 to 1000 logical pixels")
    if region is not None:
        x, y, width, height = region
        if not (0 <= x <= 1 and 0 <= y <= 1 and 0 < width <= 1 and 0 < height <= 1):
            raise AgentSeatError("INVALID_PARAMS: --region uses normalized X Y WIDTH HEIGHT")
    started = time.monotonic()
    deadline = started + timeout_ms / 1000
    if since is None:
        since = rpc("session.heartbeat").get("output", {}).get("content_serial")
        if since is None:
            raise AgentSeatError("UNSUPPORTED: this microhost does not report content changes")
    elif not 0 <= since < 2**32:
        raise AgentSeatError("INVALID_PARAMS: --since must be a content serial")
    cursor = since
    qualifying = ignored = 0
    gap = False
    union: list[int] | None = None
    last_change: float | None = None
    output: dict[str, Any] = {}
    status = "timeout"
    while True:
        reply = rpc("content.changes", {"after_serial": cursor})
        output = reply["output"]
        pixel_width = max(int(output.get("pixel_width") or 0), 1)
        pixel_height = max(int(output.get("pixel_height") or 0), 1)
        min_pixels = min_extent * float(output.get("scale") or 1)
        if region is not None:
            rx, ry = region[0] * pixel_width, region[1] * pixel_height
            rx2, ry2 = rx + region[2] * pixel_width, ry + region[3] * pixel_height
        if reply["gap"]:
            # Evicted changes may have qualified; fail toward "changed".
            gap = True
            last_change = time.monotonic()
        for change in reply["changes"]:
            x1, y1 = change["x"], change["y"]
            x2, y2 = x1 + change["width"], y1 + change["height"]
            inside = region is None or (x1 < rx2 and x2 > rx and y1 < ry2 and y2 > ry)
            large = change["width"] >= min_pixels and change["height"] >= min_pixels
            if inside and large and change["area"] >= min_area_ratio * pixel_width * pixel_height:
                qualifying += 1
                last_change = time.monotonic()
                union = [x1, y1, x2, y2] if union is None else [
                    min(union[0], x1), min(union[1], y1), max(union[2], x2), max(union[3], y2)]
            else:
                ignored += 1
        cursor = reply["content_serial"]
        now = time.monotonic()
        if last_change is not None and (settle_ms == 0 or now - last_change >= settle_ms / 1000):
            status = "settled" if settle_ms else "changed"
            break
        if now >= deadline:
            status = "timeout" if last_change is None else "changed_unsettled"
            break
        time.sleep(0.02)
    result: dict[str, Any] = {
        "status": status, "since_serial": since, "content_serial": cursor,
        "qualifying_changes": qualifying, "ignored_changes": ignored, "gap": gap,
        "elapsed_ms": int((time.monotonic() - started) * 1000),
        "min_area_ratio": min_area_ratio, "min_extent": min_extent, "region": list(region) if region else None,
        "verification": "damage_only; observe to read the new content",
    }
    if union is not None:
        pixel_width = max(int(output.get("pixel_width") or 0), 1)
        pixel_height = max(int(output.get("pixel_height") or 0), 1)
        result["changed_box"] = {
            "x": union[0] / pixel_width, "y": union[1] / pixel_height,
            "width": (union[2] - union[0]) / pixel_width, "height": (union[3] - union[1]) / pixel_height,
            "coordinate_space": "normalized-output",
        }
    return result


def a11y_read(action: str, **params: Any) -> Any:
    state_value = load_state()
    if not state_value.get("launch", {}).get("a11y"):
        raise AgentSeatError("A11Y_DISABLED: launch this application with --a11y")
    try:
        receipt = json.loads((RUNTIME / "a11y.json").read_text())
        pid = int(receipt["bridge_pid"])
        fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        if fields[19] != receipt["bridge_start"]:
            raise AgentSeatError("A11Y_SCOPE_STALE")
        cursor = pid
        for _ in range(32):
            if cursor == microhost_pid():
                break
            cursor = int(Path(f"/proc/{cursor}/stat").read_text().rsplit(")", 1)[1].split()[1])
            if cursor <= 1:
                raise AgentSeatError("A11Y_SCOPE_OUTSIDE_APPLICATION")
        else:
            raise AgentSeatError("A11Y_SCOPE_OUTSIDE_APPLICATION")
        if receipt["socket"] != str(RUNTIME / "a11y.sock"):
            raise AgentSeatError("A11Y_SOCKET_MISMATCH")
        method = action if action.startswith(("events.", "wait.")) else f"a11y.{action}"
        expected_scope = params.pop("expect_scope", EXPECTED_A11Y_SCOPE)
        if expected_scope is not None and expected_scope != receipt["scope_id"]:
            raise AgentSeatError("A11Y_SCOPE_CHANGED")
        request = {**params, "scope_id": receipt["scope_id"], "method": method}
        if "value" in request:
            request["node_ref" if action in {"get", "text", "text_state"} else "query"] = request.pop("value")
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(4)
            client.connect(receipt["socket"])
            peer_pid, peer_uid, _ = struct.unpack("3i", client.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
            if peer_pid != pid or peer_uid != os.getuid():
                raise AgentSeatError("A11Y_BRIDGE_PEER_MISMATCH")
            client.sendall((json.dumps(request) + "\n").encode())
            data = bytearray()
            while b"\n" not in data:
                chunk = client.recv(65536)
                if not chunk or len(data) + len(chunk) > RPC_LIMIT:
                    raise AgentSeatError("A11Y_RESPONSE_INVALID")
                data.extend(chunk)
        response = json.loads(data.split(b"\n")[0])
        if "error" in response:
            raise AgentSeatError(response["error"]["kind"])
        return response["result"]
    except (OSError, KeyError, ValueError) as error:
        raise AgentSeatError(f"A11Y_UNAVAILABLE: {error}") from error


def semantic_action(method: str, params: dict[str, Any]) -> dict[str, Any]:
    result = rpc(method, params)
    origin = {key: result[key] for key in ("request_id", "request_controller_id") if key in result}
    operation_id = result["operation_id"]
    deadline, renew_at = time.monotonic() + 16, time.monotonic() + 2
    try:
        while result.get("execution") == "running":
            if time.monotonic() >= deadline:
                raise AgentSeatError(f"OPERATION_UNCONFIRMED: query {operation_id} before attempting another action")
            time.sleep(.02)
            result = rpc("operation.get", {"operation_id": operation_id})
            if RPC_WRITE_LEASE and result.get("execution") == "running" and time.monotonic() >= renew_at:
                rpc("control.renew", {"lease_id": RPC_WRITE_LEASE["lease_id"], "ttl_ms": 10000})
                renew_at = time.monotonic() + 2
    except (KeyboardInterrupt, AgentSeatError):
        try: rpc("operation.cancel", {"operation_id": operation_id})
        except AgentSeatError: pass
        raise
    return {**result, **origin}


def semantic_wait(condition: dict[str, Any], timeout_ms: int) -> dict[str, Any]:
    result = a11y_read("wait.start", condition=condition, timeout_ms=timeout_ms)
    wait_id = result["wait_id"]
    deadline = time.monotonic() + timeout_ms / 1000 + 4
    try:
        while result["status"] == "pending":
            if time.monotonic() >= deadline:
                raise AgentSeatError("WAIT_UNCONFIRMED")
            time.sleep(.05)
            result = a11y_read("wait.get", wait_id=wait_id)
    except (KeyboardInterrupt, AgentSeatError):
        try: a11y_read("wait.cancel", wait_id=wait_id)
        except AgentSeatError: pass
        raise
    return result


def collaboration_status() -> dict[str, Any]:
    return rpc("collaboration.status")


# Chromium and Electron expose only the window frame until renderer
# accessibility is on; the web contents appear as an AT-SPI null child.
CHROMIUM_WEB_HIDDEN = ("Chromium/Electron web content is not exposed; relaunch the application "
                       "with --force-renderer-accessibility for semantic reads")


def probe_session() -> dict[str, Any]:
    """Collect read-only session facts; never focuses, acquires or injects."""
    facts: dict[str, Any] = {"running": bool(microhost_pid() and CONTROL_SOCKET.exists())}
    if not facts["running"]:
        return facts
    try:
        facts["heartbeat"] = rpc("session.heartbeat")
        facts["windows"] = rpc("window.list")
    except AgentSeatError as exc:
        facts["error"] = str(exc)
        return facts
    facts["daemon"] = version().get("daemon") or {}
    facts["launch"] = load_state().get("launch", {})
    if facts["launch"].get("a11y"):
        try:
            facts["a11y"] = a11y_read("status")
            snapshot = a11y_read("snapshot", max_nodes=8, max_depth=3)
            facts["a11y_nodes"] = len(snapshot.get("nodes", []))
            toolkits = {node.get("toolkit") for node in snapshot.get("nodes", [])} - {None}
            if "Chromium" in toolkits and snapshot.get("null_children"):
                facts["a11y_note"] = CHROMIUM_WEB_HIDDEN
        except AgentSeatError as exc:
            if "SEMANTICS_UNAVAILABLE" in str(exc):
                facts["a11y_nodes"] = 0
            else:
                facts["a11y_error"] = str(exc)
    return facts


def python_module_available(statement: str) -> bool:
    try:
        return subprocess.run([sys.executable, "-c", statement], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5, check=False).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def doctor(probe_capture: bool = False) -> dict[str, Any]:
    """Diagnose only: report backends, scope, mapping and degradations."""
    checks: list[dict[str, Any]] = []

    def check(name: str, status: str, detail: Any = None) -> None:
        checks.append({"check": name, "status": status, "detail": detail})

    check("python", "ok" if sys.version_info >= (3, 11) else "fail", platform.python_version())
    hyprland = bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"))
    check("hyprland_host", "ok" if hyprland else "fail",
          None if hyprland else "HYPRLAND_INSTANCE_SIGNATURE and hyprctl are required for the host window")
    check("wayland_display", "ok" if os.environ.get("WAYLAND_DISPLAY") else "fail", None)
    binaries = {path.name: os.access(path, os.X_OK) for path in (NATIVE_DAEMON, MICROHOST_EXE, EYE_BINARY, RUN_MICROHOST, LAUNCH_APP)}
    binaries["libagentseat-atk-dispatch.so"] = (ROOT / "lib/libagentseat-atk-dispatch.so").is_file()
    missing = sorted(name for name, present in binaries.items() if not present)
    check("runtime_files", "fail" if missing else "ok", {"root": str(ROOT), "missing": missing})
    check("xwayland", "ok" if Path("/usr/bin/Xwayland").is_file() else "warn",
          None if Path("/usr/bin/Xwayland").is_file() else "--x11 and --ime fcitx5 are unavailable")
    atspi = python_module_available("import gi; gi.require_version('Atspi', '2.0'); from gi.repository import Atspi")
    check("a11y_dependencies", "ok" if atspi else "warn", None if atspi else "--a11y needs Python GObject and AT-SPI2")
    modules = {name: os.environ.get(name) for name in ("GTK_IM_MODULE", "QT_IM_MODULE", "XMODIFIERS")}
    check("input_method", "ok", {"modules": modules, "auto_resolves_to": resolve_ime("auto")})

    facts = probe_session()
    if not facts["running"]:
        check("session", "skip", "no AgentSeat session for this instance")
    elif "error" in facts:
        check("session", "fail", facts["error"])
    else:
        heartbeat = facts["heartbeat"]
        daemon = facts["daemon"]
        check("session", "ok", {"session_id": heartbeat["session_id"], "uptime_ms": heartbeat.get("uptime_ms"),
                                "instance": SELECTED_INSTANCE})
        same_version = daemon.get("version") == AGENTSEAT_VERSION
        check("daemon_version", "ok" if same_version else "warn",
              {"controller": AGENTSEAT_VERSION, "daemon": daemon.get("version")})
        windows = facts["windows"]
        unverified = [w["id"] for w in windows if not w.get("pid_verified") or not w.get("leased")]
        output = heartbeat.get("output", {})
        check("application_scope", "warn" if unverified or output.get("truncated") else "ok",
              {"windows": len(windows), "unverified_or_unleased": unverified, "truncated": output.get("truncated")})
        scale = float(output.get("scale") or 0)
        consistent = scale > 0 and all(abs(output.get(f"pixel_{k}", 0) - output.get(k, 0) * scale) <= 1 for k in ("width", "height"))
        check("coordinate_mapping", "ok" if consistent else "warn",
              {"logical": [output.get("width"), output.get("height")],
               "pixels": [output.get("pixel_width"), output.get("pixel_height")], "scale": scale,
               "pointer_space": "normalized-output"})
        check("visual_wait", "ok" if output.get("content_serial") is not None else "warn",
              None if output.get("content_serial") is not None else "microhost predates content serial; wait-change unavailable")
        collaboration = heartbeat.get("collaboration", {})
        writer = heartbeat.get("write_control", {})
        holder = writer.get("controller_id") or None
        writable = collaboration.get("agent_allowed") and not heartbeat.get("seat_paused") and holder in {None, RPC_CONTROLLER_ID}
        check("agent_input", "ok" if writable else "warn",
              {"seat_paused": heartbeat.get("seat_paused"), "human_active": collaboration.get("human_active"),
               "write_lease_holder": writer.get("controller_id") or None})
        ime = facts["launch"].get("ime")
        check("text_lane", "ok", {"ime": ime, "lane": text_lane(ime)})
        if not facts["launch"].get("a11y"):
            check("a11y", "skip", "launch with --a11y for semantic reads and actions")
        elif "a11y_error" in facts:
            check("a11y", "fail", facts["a11y_error"])
        else:
            nodes = facts.get("a11y_nodes", 0)
            note = facts.get("a11y_note") or (
                None if nodes > 1 else "application exposes no controls beyond its root; use visual input")
            check("a11y", "ok" if note is None else "warn",
                  {"scope": facts["a11y"].get("scope"), "sample_nodes": nodes, "note": note})
        if probe_capture:
            started = time.monotonic()
            try:
                frame = rpc("capture.submit")
                while frame["status"] in {"pending", "encoding"} and time.monotonic() - started < 5:
                    time.sleep(0.01)
                    frame = rpc("capture.get", {"frame_id": frame["frame_id"]})
                matches = [frame.get("width"), frame.get("height")] == [output.get("pixel_width"), output.get("pixel_height")]
                check("capture", "ok" if frame["status"] == "finished" and matches else "warn",
                      {"status": frame["status"], "latency_ms": int((time.monotonic() - started) * 1000),
                       "frame": [frame.get("width"), frame.get("height")], "matches_output_pixels": matches})
            except AgentSeatError as exc:
                check("capture", "fail", str(exc))
        else:
            check("capture", "skip", "pass --probe-capture to time one private frame")
    worst = {"ok": 0, "skip": 0, "warn": 1, "fail": 2}
    level = max((worst[item["status"]] for item in checks), default=0)
    return {"status": ("ok", "degraded", "failing")[level], "checks": checks,
            "degradations": [f"{item['check']}: {item['detail']}" for item in checks if item["status"] in {"warn", "fail"}]}


def text_lane(ime: str | None) -> str:
    if ime == "simple":
        return "keyboard.type"
    return "keyboard.paste (chunked); type --keys sends key events"


def capabilities() -> dict[str, Any]:
    """Separate implemented, exposed by the application, authorized and available."""
    facts = probe_session()
    live = facts["running"] and "error" not in facts
    heartbeat = facts.get("heartbeat", {})
    windows = facts.get("windows", [])
    collaboration = heartbeat.get("collaboration", {})
    writer = heartbeat.get("write_control", {}).get("controller_id")
    writes_allowed = live and bool(collaboration.get("agent_allowed")) and not heartbeat.get("seat_paused") and \
        writer in {"", None, RPC_CONTROLLER_ID}
    launch = facts.get("launch", {})
    content = heartbeat.get("output", {}).get("content_serial") is not None
    clipboard = bool(facts.get("daemon", {}).get("private_clipboard", {}).get("available"))
    a11y_ready = live and bool(launch.get("a11y")) and "a11y" in facts
    a11y_nodes = facts.get("a11y_nodes", 0) > 1

    def entry(implemented: bool, exposes: bool | None, authorized: bool | None, *,
              missing: str | None = None, hidden: str | None = None, denied: str | None = None) -> dict[str, Any]:
        available = bool(implemented and live and exposes is not False and authorized is not False)
        # Report the check that actually failed, in evaluation order.
        if available:
            reason = None
        elif not implemented:
            reason = missing or "not implemented by this runtime"
        elif not live:
            reason = "no session"
        elif exposes is False:
            reason = hidden
        else:
            reason = denied
        return {"implemented": implemented, "application_exposes": exposes, "session_authorized": authorized,
                "available": available, "reason": reason}

    has_windows = bool(windows) if live else None
    write_reason = "seat paused, human active or another controller holds the write lease"
    a11y_launched = bool(launch.get("a11y")) if live else None
    semantic_exposes = a11y_nodes if a11y_ready else None
    semantic_hidden = facts.get("a11y_error") or (
        "application exposes no accessible controls; use visual input" if a11y_ready else None)
    semantic_denied = "launch with --a11y"
    result = {
        "observe.capture": entry(True, has_windows, True if live else None, hidden="no mapped window"),
        "observe.wait_change": entry(content, True if live else None, True if live else None,
                                     missing="microhost predates content serial"),
        "input.pointer": entry(True, has_windows, writes_allowed if live else None,
                               hidden="no mapped window", denied=write_reason),
        "input.keys": entry(True, has_windows, writes_allowed if live else None,
                            hidden="no mapped window", denied=write_reason),
        "input.text": {**entry(True, has_windows, writes_allowed if live else None,
                               hidden="no mapped window", denied=write_reason),
                       "lane": text_lane(launch.get("ime")) if live else None},
        "input.private_paste": entry(clipboard, has_windows, writes_allowed if live else None,
                                     missing="daemon has no private clipboard", hidden="no mapped window",
                                     denied=write_reason),
        "windows.focus_move_resize_close": {**entry(True, has_windows, writes_allowed if live else None,
                                                    hidden="no mapped window", denied=write_reason),
                                            "verification": "compositor_confirmed"},
        "semantic.read": {**entry(True, semantic_exposes, a11y_launched, hidden=semantic_hidden, denied=semantic_denied),
                          "note": facts.get("a11y_note")},
        "semantic.actions": {**entry(True, semantic_exposes, (a11y_launched and writes_allowed) if live else None,
                                     hidden=semantic_hidden,
                                     denied=semantic_denied if live and not launch.get("a11y") else write_reason),
                             "per_node": "inspect a11y get; each node lists its own actions and interfaces"},
        "semantic.events_wait": entry(True, semantic_exposes, a11y_launched, hidden=semantic_hidden,
                                      denied=semantic_denied),
    }
    return {"session": heartbeat.get("session_id"), "controller_id": RPC_CONTROLLER_ID, "capabilities": result}


def set_activity(summary: str, detail: str) -> dict[str, Any]:
    return rpc("activity.set", {"summary": summary, "detail": detail})


def list_messages(after_id: int) -> dict[str, Any]:
    return rpc("chat.list", {"after_id": after_id})


def reply_message(text: str) -> dict[str, Any]:
    return rpc("chat.reply", {"text": text})


def main() -> int:
    global RPC_CONTROLLER_ID, EXPECTED_A11Y_SCOPE
    global PREFERENCES
    cli_language = language_override(sys.argv[1:])
    configure_i18n(cli_language or os.environ.get("AGENTSEAT_LANGUAGE", "auto"))
    PREFERENCES = load_preferences()
    configure_i18n(
        cli_language
        or os.environ.get("AGENTSEAT_LANGUAGE")
        or str(PREFERENCES["language"])
    )
    argparse._ = _
    parser = argparse.ArgumentParser(
        prog="agentseat",
        description=_("Operate one local application with a private AI pointer and keyboard."),
    )
    parser.add_argument(
        "--language",
        type=language_option,
        metavar="LANG",
        help=_("interface language: auto, en, zh-CN, or zh-TW"),
    )
    parser.add_argument(
        "--instance",
        type=normalize_instance_id,
        metavar="ID",
        help=_("operate one named AgentSeat application instance"),
    )
    parser.add_argument("--controller", help="stable identity for this application's write controller")
    commands = parser.add_subparsers(dest="command", required=True)
    control_parser = commands.add_parser("control", help="inspect, acquire or release the application write lease")
    control_parser.add_argument("action", choices=("status", "acquire", "release"), nargs="?", default="status")
    window_parser = commands.add_parser("window", help="change a real application window")
    window_commands = window_parser.add_subparsers(dest="action", required=True)
    for action_name, parameters in (("focus", ()), ("close", ()), ("move", ("x", "y")), ("resize", ("width", "height"))):
        action_parser = window_commands.add_parser(action_name)
        action_parser.add_argument("window_id")
        for name in parameters:
            action_parser.add_argument(name, type=int)
    request_parser = commands.add_parser("receipt", help="read a retained write receipt without replaying it")
    request_parser.add_argument("request_id", type=int)
    request_parser.add_argument("--owner", help="controller identity that submitted the request")

    start_parser = commands.add_parser("start", help=_("start a legacy verified demo"))
    start_parser.add_argument("preset", choices=("onlyoffice",), nargs="?", default="onlyoffice")
    start_parser.add_argument(
        "--host-workspace",
        type=int,
        default=PREFERENCES["default_workspace"],
        help=_("place the outer window on this host workspace"),
    )
    run_parser = commands.add_parser("run", help=_("wrap an arbitrary application command"))
    run_parser.add_argument(
        "--x11",
        action="store_true",
        help=_("force the generic private-XWayland compatibility lane"),
    )
    run_parser.add_argument(
        "--private-dbus",
        action="store_true",
        help=_("run the application on a private D-Bus session bus"),
    )
    run_parser.add_argument("--ime", choices=("auto", "simple", "fcitx5", "desktop", "inherit"), default="auto", help="input method: auto preserves user settings; fcitx5 starts an explicit private copy")
    run_parser.add_argument("--a11y", action="store_true", help="enable private accessibility reads and guarded actions")
    run_parser.add_argument("--cwd", help=_("working directory for the wrapped application"))
    run_parser.add_argument(
        "--host-workspace",
        type=int,
        default=PREFERENCES["default_workspace"],
        help=_("place the outer window on this host workspace"),
    )
    run_parser.add_argument("argv", nargs=argparse.REMAINDER, help=_("application command after --"))
    launch_parser = commands.add_parser(
        "launch",
        help=_("wrap an application in a new automatically named instance"),
    )
    launch_parser.add_argument(
        "--x11",
        action="store_true",
        help=_("force the generic private-XWayland compatibility lane"),
    )
    launch_parser.add_argument(
        "--private-dbus",
        action="store_true",
        help=_("run the application on a private D-Bus session bus"),
    )
    launch_parser.add_argument("--ime", choices=("auto", "simple", "fcitx5", "desktop", "inherit"), default="auto", help="input method: auto preserves user settings; fcitx5 starts an explicit private copy")
    launch_parser.add_argument("--a11y", action="store_true", help="enable private accessibility reads and guarded actions")
    launch_parser.add_argument("--cwd", help=_("working directory for the wrapped application"))
    launch_parser.add_argument(
        "--host-workspace",
        default="current",
        metavar="N|current",
        help=_("place the outer window on the current or named host workspace"),
    )
    launch_parser.add_argument("argv", nargs=argparse.REMAINDER, help=_("application command after --"))
    commands.add_parser("version", help=_("show the controller and protocol version"))
    commands.add_parser("paths", help=_("show AgentSeat's XDG storage locations"))
    commands.add_parser("config", help=_("show the effective AgentSeat configuration"))
    commands.add_parser("status", help=_("show the current AgentSeat session"))
    commands.add_parser("instances", help=_("list named AgentSeat application instances"))
    heartbeat_parser = commands.add_parser(
        "heartbeat",
        help=_("verify that the current application session can be reconnected"),
    )
    heartbeat_parser.add_argument(
        "--expect-session",
        help=_("fail if the connected session does not have this identity"),
    )
    watch_parser = commands.add_parser(
        "watch",
        help=_("continuously reconnect and stream session heartbeats"),
    )
    watch_parser.add_argument(
        "--interval",
        type=float,
        default=5.0,
        help=_("seconds between reconnect checks"),
    )
    watch_parser.add_argument(
        "--count",
        type=int,
        default=0,
        help=_("number of checks; zero keeps watching until interrupted"),
    )
    watch_parser.add_argument(
        "--expect-session",
        help=_("fail if the connected session does not have this identity"),
    )
    hud_parser = commands.add_parser("hud", help=_("control the embedded private-microhost AI head"))
    hud_parser.add_argument("action", choices=("start", "stop", "status"))
    commands.add_parser("collaboration", help=_("show human-priority and AI activity state"))
    activity_parser = commands.add_parser("activity", help=_("publish the Agent's current AgentSeat action"))
    activity_parser.add_argument("summary")
    activity_parser.add_argument("--detail", default="")
    messages_parser = commands.add_parser("messages", help=_("read messages sent from the eye HUD"))
    messages_parser.add_argument("--after", type=int, default=0)
    reply_parser = commands.add_parser("reply", help=_("reply to the human in the eye HUD"))
    reply_parser.add_argument("text")
    a11y_parser = commands.add_parser("a11y", help="scoped controls, native semantic actions and condition waits")
    a11y_parser.add_argument("action", choices=("status", "snapshot", "query", "get", "text", "text-state", "perform", "set-text", "set-value", "focus", "select", "scroll-to", "subscribe", "events", "wait", "wait-start", "wait-get", "wait-cancel"))
    a11y_parser.add_argument("value", nargs="?")
    a11y_parser.add_argument("argument", nargs="?")
    a11y_parser.add_argument("--snapshot-id")
    a11y_parser.add_argument("--root-ref")
    a11y_parser.add_argument("--max-nodes", type=int, default=512)
    a11y_parser.add_argument("--max-depth", type=int, default=16)
    a11y_parser.add_argument("--offset", type=int, default=0)
    a11y_parser.add_argument("--limit", type=int, default=64)
    a11y_parser.add_argument("--exact", action="store_true")
    a11y_parser.add_argument("--role")
    a11y_parser.add_argument("--interface")
    a11y_parser.add_argument("--expect-scope")
    a11y_parser.add_argument("--state", action="append", default=[])
    a11y_parser.add_argument("--start", type=int, default=0)
    a11y_parser.add_argument("--count", type=int, default=1024)
    a11y_parser.add_argument("--after", type=int, default=0)
    a11y_parser.add_argument("--timeout-ms", type=int, default=5000)
    a11y_parser.add_argument("--condition", help="JSON condition for wait or optional post-action verification")
    commands.add_parser("windows", help=_("list windows in the wrapped application tree"))
    commands.add_parser("pause", help=_("pause Agent input"))
    commands.add_parser("resume", help=_("resume Agent input"))
    move_parser = commands.add_parser("move", help=_("move the private pointer using normalized coordinates"))
    move_parser.add_argument("x", type=float)
    move_parser.add_argument("y", type=float)
    click_parser = commands.add_parser("click", help=_("click with the private pointer"))
    click_parser.add_argument("button", type=int, nargs="?", default=272)
    scroll_parser = commands.add_parser("scroll", help=_("scroll inside the wrapped application"))
    scroll_parser.add_argument("axis", choices=("vertical", "horizontal"))
    scroll_parser.add_argument("value120", type=int)
    key_parser = commands.add_parser("key", help=_("send one scoped evdev key event"))
    key_parser.add_argument("keycode", type=int)
    key_parser.add_argument("state", choices=("down", "up"))
    type_parser = commands.add_parser("type", help=_("type text with the private keyboard"))
    type_parser.add_argument("text")
    type_parser.add_argument(
        "--keys", action="store_true",
        help=_("send key events instead of a private paste, for applications that ignore paste"))
    observe_parser = commands.add_parser("observe", help=_("capture the private application output"))
    observe_parser.add_argument("path", nargs="?")
    doctor_parser = commands.add_parser("doctor", help="diagnose dependencies, scope, mapping and degradations")
    doctor_parser.add_argument("--probe-capture", action="store_true", help="time one private frame capture")
    commands.add_parser("capabilities", help="list implemented, exposed, authorized and available capabilities")
    wait_change_parser = commands.add_parser("wait-change", help="wait until the application output changes")
    wait_change_parser.add_argument("--since", type=int, help="content_serial from observe; default is now")
    wait_change_parser.add_argument("--timeout-ms", type=int, default=5000)
    wait_change_parser.add_argument("--settle-ms", type=int, default=0, help="then wait until changes stop for this long")
    wait_change_parser.add_argument("--region", type=float, nargs=4, metavar=("X", "Y", "WIDTH", "HEIGHT"))
    wait_change_parser.add_argument("--min-area-ratio", type=float, default=0.0)
    wait_change_parser.add_argument("--min-extent", type=float, default=WAIT_CHANGE_DEFAULT_MIN_EXTENT,
        help="minimum damage width and height in logical pixels")
    commands.add_parser("stop", help=_("stop the current AgentSeat session"))
    args = parser.parse_args()
    if args.controller:
        if len(args.controller) > 128 or "\0" in args.controller:
            raise AgentSeatError("controller identity must be a NUL-free string of at most 128 characters")
        RPC_CONTROLLER_ID = args.controller


    if args.command in {"launch", "instances"} and args.instance:
        parser.error(_("--instance cannot be combined with {command}").format(command=args.command))
    if args.instance and SELECTED_INSTANCE != args.instance:
        execute_for_instance(args.instance, sys.argv[1:])
        return 0

    if args.command == "launch":
        application_argv = normalize_argv(args.argv)
        instance_id = allocate_instance_id(application_argv)
        forwarded: list[str] = []
        if args.language:
            forwarded.extend(["--language", str(args.language)])
        forwarded.extend(["--instance", instance_id, "run"])
        if args.x11:
            forwarded.append("--x11")
        if args.private_dbus:
            forwarded.append("--private-dbus")
        if args.a11y:
            forwarded.append("--a11y")
        forwarded.extend(["--ime", args.ime])
        if args.cwd:
            forwarded.extend(["--cwd", args.cwd])
        forwarded.extend([
            "--host-workspace",
            str(launch_workspace(args.host_workspace)),
            "--",
            *application_argv,
        ])
        execute_for_instance(instance_id, forwarded)
        return 0
    if args.command == "start":
        argv, mode, compat_type = legacy_command(args.preset)
        result = start_safely(
            argv,
            mode=mode,
            cwd=normalized_cwd(None),
            host_workspace=args.host_workspace,
            legacy_preset=args.preset,
            compat_type=compat_type,
            ime=resolve_ime("auto"),
        )
    elif args.command == "run":
        result = start_safely(
            normalize_argv(args.argv),
            mode="x11" if args.x11 else "wayland",
            cwd=normalized_cwd(args.cwd),
            host_workspace=args.host_workspace,
            private_dbus=args.private_dbus,
            a11y=args.a11y,
            ime=resolve_ime(args.ime, args.private_dbus),
        )
    elif args.command == "version":
        result = version()
    elif args.command == "paths":
        result = storage_paths()
    elif args.command == "config":
        result = configuration_status()
    elif args.command == "status":
        result = status()
    elif args.command == "instances":
        result = list_instances()
    elif args.command == "heartbeat":
        result = session_heartbeat(args.expect_session)
    elif args.command == "watch":
        watch_session(
            interval=args.interval,
            count=args.count,
            expected_session_id=args.expect_session,
        )
        return 0
    elif args.command == "hud":
        if args.action == "start":
            result = start_hud()
        elif args.action == "stop":
            result = stop_hud()
        else:
            result = {
                "running": eye_pid() is not None,
                "pid": eye_pid(),
                "connected": CONTROL_SOCKET.exists(),
                "enabled_by_config": bool(PREFERENCES["eye_hud"]),
                "scope": "private-microhost",
                "default_corner": "bottom-right",
            }
    elif args.command == "window":
        parameters = {name: getattr(args, name) for name in ("window_id", "x", "y", "width", "height") if hasattr(args, name)}
        result = window_action("window." + args.action, parameters)
    elif args.command == "control":
        if args.action == "release":
            result = release_write_control()
        else:
            result = rpc("control." + args.action)
    elif args.command == "receipt":
        result = rpc("request.get", {"controller_id": args.owner or RPC_CONTROLLER_ID, "request_id": args.request_id})
    elif args.command == "collaboration":
        result = collaboration_status()
    elif args.command == "activity":
        result = set_activity(args.summary, args.detail)
    elif args.command == "messages":
        result = list_messages(args.after)
    elif args.command == "reply":
        result = reply_message(args.text)
    elif args.command == "a11y":
        condition = json.loads(args.condition) if args.condition else None
        EXPECTED_A11Y_SCOPE = args.expect_scope
        if args.action in {"perform", "set-text", "set-value", "focus", "select", "scroll-to"}:
            if not args.value: raise AgentSeatError("node_ref is required")
            params = {"node_ref": args.value, "timeout_ms": args.timeout_ms}
            if args.action == "perform":
                if args.argument is None: raise AgentSeatError("an actual action name or index is required; inspect a11y get first")
                params["action"] = int(args.argument) if args.argument.isdecimal() else args.argument
            elif args.action == "set-text":
                if args.argument is None: raise AgentSeatError("text is required")
                params["text"] = args.argument
            elif args.action == "set-value": params["value"] = float(args.argument)
            elif args.action == "select": params["index"] = int(args.argument)
            result = semantic_action("a11y." + args.action.replace("-", "_"), params)
            if condition is not None and result["execution"] == "finished":
                result["postcondition"] = semantic_wait(condition, args.timeout_ms)
                result["verification"] = "condition_satisfied" if result["postcondition"]["status"] == "satisfied" else "condition_not_satisfied"
        elif args.action in {"wait", "wait-start"}:
            if condition is None: raise AgentSeatError("--condition JSON is required")
            result = semantic_wait(condition, args.timeout_ms) if args.action == "wait" else a11y_read("wait.start", condition=condition, timeout_ms=args.timeout_ms)
        elif args.action in {"wait-get", "wait-cancel"}:
            result = a11y_read(args.action.replace("-", "."), wait_id=args.value)
        elif args.action == "subscribe": result = a11y_read("events.subscribe")
        elif args.action == "events": result = a11y_read("events.read", after=args.after, limit=args.limit)
        elif args.action == "text": result = a11y_read("text", value=args.value, start=args.start, count=args.count)
        elif args.action == "text-state": result = a11y_read("text_state", value=args.value)
        elif args.action == "get": result = a11y_read("get", value=args.value)
        elif args.action == "status": result = a11y_read("status")
        else:
            params = {"limit": args.limit, "offset": args.offset, "max_nodes": args.max_nodes, "max_depth": args.max_depth}
            if args.snapshot_id: params["snapshot_id"] = args.snapshot_id
            if args.root_ref: params["root_ref"] = args.root_ref
            if args.action == "query":
                if args.exact or args.role or args.state or args.interface:
                    params["selector"] = {"name": args.value or "", "exact": args.exact, "role": args.role, "states": args.state, "interface": args.interface}
                else: params["value"] = args.value
            result = a11y_read(args.action, **params)
    elif args.command == "windows":
        result = sync_window_tree()
    elif args.command == "pause":
        result = pause_seat()
    elif args.command == "resume":
        result = rpc("seat.resume")
    elif args.command == "move":
        result = pointer_move(args.x, args.y)
    elif args.command == "click":
        result = pointer_click(args.button)
    elif args.command == "scroll":
        sync_window_tree()
        result = pointer_scroll(args.axis, args.value120)
    elif args.command == "key":
        result = keyboard_key(args.keycode, args.state == "down")
    elif args.command == "type":
        sync_window_tree()
        try:
            result = type_text(args.text, keys=args.keys)
        except AgentSeatError as exc:
            if args.keys or not str(exc).startswith("UNSUPPORTED_CHARACTER:"):
                raise
            result = private_unicode_paste(args.text)
    elif args.command == "observe":
        result = observe(args.path)
    elif args.command == "doctor":
        result = doctor(args.probe_capture)
    elif args.command == "capabilities":
        result = capabilities()
    elif args.command == "wait-change":
        result = wait_for_change(args.since, args.timeout_ms, tuple(args.region) if args.region else None,
            args.min_area_ratio, args.settle_ms, args.min_extent)
    elif args.command == "stop":
        result = stop()
    else:
        raise AgentSeatError(_("unknown command"))
    output_json(result)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except AgentSeatError as exc:
        print(json.dumps({"error": str(exc)}, ensure_ascii=False), file=sys.stderr)
        raise SystemExit(1)
