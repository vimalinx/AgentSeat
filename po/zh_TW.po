#: lib/agentseat_cli/cli.py:26
msgid "Operate one local application with a private AI pointer and keyboard."
msgstr "使用 AI 的私有游標和鍵盤操作一個本機應用程式。"

#: lib/agentseat_cli/cli.py:32
msgid "interface language: auto, en, zh-CN, or zh-TW"
msgstr "介面語言：auto、en、zh-CN 或 zh-TW"

#: lib/agentseat_cli/cli.py:38
msgid "operate one named AgentSeat application instance"
msgstr "操作一個具名的 AgentSeat 應用程式執行個體"

#: lib/agentseat_cli/cli.py:55
msgid "start a legacy verified demo"
msgstr "啟動已驗證的舊版示範"

#: lib/agentseat_cli/cli.py:61 lib/agentseat_cli/cli.py:81
msgid "place the outer window on this host workspace"
msgstr "將外層視窗放到這個宿主工作區"

#: lib/agentseat_cli/cli.py:63
msgid "wrap an arbitrary application command"
msgstr "封裝任意應用程式命令"

#: lib/agentseat_cli/cli.py:67 lib/agentseat_cli/cli.py:91
msgid "force the generic private-XWayland compatibility lane"
msgstr "強制使用通用私有 XWayland 相容通道"

#: lib/agentseat_cli/cli.py:72 lib/agentseat_cli/cli.py:96
msgid "run the application on a private D-Bus session bus"
msgstr "在私有 D-Bus 工作階段匯流排上執行應用程式"

#: lib/agentseat_cli/cli.py:76 lib/agentseat_cli/cli.py:100
msgid "working directory for the wrapped application"
msgstr "被封裝應用程式的工作目錄"

#: lib/agentseat_cli/cli.py:83 lib/agentseat_cli/cli.py:107
msgid "application command after --"
msgstr "-- 後的應用程式命令"

#: lib/agentseat_cli/cli.py:86
msgid "wrap an application in a new automatically named instance"
msgstr "在自動命名的新執行個體中封裝應用程式"

#: lib/agentseat_cli/cli.py:105
msgid "place the outer window on the current or named host workspace"
msgstr "將外層視窗放到目前或指定的宿主工作區"

#: lib/agentseat_cli/cli.py:108
msgid "show the controller and protocol version"
msgstr "顯示控制器和通訊協定版本"

#: lib/agentseat_cli/cli.py:109
msgid "show AgentSeat's XDG storage locations"
msgstr "顯示 AgentSeat 的 XDG 儲存位置"

#: lib/agentseat_cli/cli.py:110
msgid "show the effective AgentSeat configuration"
msgstr "顯示目前有效的 AgentSeat 設定"

#: lib/agentseat_cli/cli.py:111
msgid "show the current AgentSeat session"
msgstr "顯示目前 AgentSeat 工作階段"

#: lib/agentseat_cli/cli.py:112
msgid "list named AgentSeat application instances"
msgstr "列出具名的 AgentSeat 應用程式執行個體"

#: lib/agentseat_cli/cli.py:115
msgid "verify that the current application session can be reconnected"
msgstr "驗證目前應用程式工作階段是否可以重新連線"

#: lib/agentseat_cli/cli.py:119 lib/agentseat_cli/cli.py:139
msgid "fail if the connected session does not have this identity"
msgstr "如果已連線工作階段不是此識別碼則失敗"

#: lib/agentseat_cli/cli.py:123
msgid "continuously reconnect and stream session heartbeats"
msgstr "持續重新連線並輸出工作階段心跳串流"

#: lib/agentseat_cli/cli.py:129
msgid "seconds between reconnect checks"
msgstr "兩次重新連線檢查之間的秒數"

#: lib/agentseat_cli/cli.py:135
msgid "number of checks; zero keeps watching until interrupted"
msgstr "檢查次數；0 表示持續監測直到被中斷"

#: lib/agentseat_cli/cli.py:141
msgid "control the embedded private-microhost AI head"
msgstr "控制嵌入私有微宿主的 AI 小腦袋"

#: lib/agentseat_cli/cli.py:143
msgid "show human-priority and AI activity state"
msgstr "顯示使用者優先與 AI 活動狀態"

#: lib/agentseat_cli/cli.py:144
msgid "publish the Agent's current AgentSeat action"
msgstr "發布 Agent 目前的 AgentSeat 操作"

#: lib/agentseat_cli/cli.py:147
msgid "read messages sent from the eye HUD"
msgstr "讀取從小腦袋 HUD 發來的訊息"

#: lib/agentseat_cli/cli.py:149
msgid "reply to the human in the eye HUD"
msgstr "回覆小腦袋 HUD 中的使用者"

#: lib/agentseat_cli/cli.py:171
msgid "list windows in the wrapped application tree"
msgstr "列出被封裝應用程式樹中的視窗"

#: lib/agentseat_cli/cli.py:172
msgid "pause Agent input"
msgstr "暫停 Agent 輸入"

#: lib/agentseat_cli/cli.py:173
msgid "resume Agent input"
msgstr "恢復 Agent 輸入"

#: lib/agentseat_cli/cli.py:174
msgid "move the private pointer using normalized coordinates"
msgstr "使用正規化座標移動私有游標"

#: lib/agentseat_cli/cli.py:177
msgid "click with the private pointer"
msgstr "使用私有游標點選"

#: lib/agentseat_cli/cli.py:179
msgid "scroll inside the wrapped application"
msgstr "在被封裝應用程式內滾動"

#: lib/agentseat_cli/cli.py:182
msgid "send one scoped evdev key event"
msgstr "傳送一個限定範圍的 evdev 按鍵事件"

#: lib/agentseat_cli/cli.py:185
msgid "type text with the private keyboard"
msgstr "使用私有鍵盤輸入文字"

#: lib/agentseat_cli/cli.py:189
msgid ""
"send key events instead of a private paste, for applications that ignore "
"paste"
msgstr "傳送按鍵事件而非私有貼上，用於不接受貼上的應用程式"

#: lib/agentseat_cli/cli.py:190
msgid "capture the private application output"
msgstr "擷取私有應用程式輸出"

#: lib/agentseat_cli/cli.py:203
msgid "stop the current AgentSeat session"
msgstr "停止目前 AgentSeat 工作階段"

#: lib/agentseat_cli/cli.py:212
#, python-brace-format
msgid "--instance cannot be combined with {command}"
msgstr "--instance 不能與 {command} 同時使用"

#: lib/agentseat_cli/cli.py:386
msgid "unknown command"
msgstr "未知命令"

#: lib/agentseat_cli/common.py:38
#, python-brace-format
msgid "command failed: {command}"
msgstr "命令執行失敗：{command}"

#: lib/agentseat_cli/common.py:60
msgid "memory-only; cleared when the daemon exits"
msgstr "僅存於記憶體；守護程式結束時清除"

#: lib/agentseat_cli/common.py:61
msgid "volatile; removed by the user session runtime manager"
msgstr "暫存資料；由使用者工作階段管理器清除"

#: lib/agentseat_cli/common.py:62
msgid "written only when observe is requested"
msgstr "僅在請求 observe 時寫入"

#: lib/agentseat_cli/common.py:75
#, python-brace-format
msgid "cannot read AgentSeat configuration {path}: {error}"
msgstr "無法讀取 AgentSeat 設定 {path}：{error}"

#: lib/agentseat_cli/common.py:79
msgid "AgentSeat configuration [general] must be a table"
msgstr "AgentSeat 設定中的 [general] 必須是 TOML 資料表"

#: lib/agentseat_cli/common.py:88
msgid "general.default_workspace must be a positive integer"
msgstr "general.default_workspace 必須是正整數"

#: lib/agentseat_cli/common.py:90
msgid "general.human_priority_grace_ms must be an integer from 0 to 60000"
msgstr "general.human_priority_grace_ms 必須是 0 到 60000 之間的整數"

#: lib/agentseat_cli/common.py:92
msgid "general.eye_hud must be true or false"
msgstr "general.eye_hud 必須是 true 或 false"

#: lib/agentseat_cli/common.py:94 lib/agentseat_cli/common.py:98
msgid "general.language must be auto, en, zh-CN, or zh-TW"
msgstr "general.language 必須是 auto、en、zh-CN 或 zh-TW"

#: lib/agentseat_cli/common.py:136 lib/agentseat_cli/common.py:144
#, python-brace-format
msgid "refusing to use an unexpected AgentSeat lifecycle lock: {path}"
msgstr "拒絕使用異常的 AgentSeat 生命週期鎖：{path}"

#: lib/agentseat_cli/common.py:202
msgid "run requires a non-empty command after --"
msgstr "run 要求在 -- 後提供命令"

#: lib/agentseat_cli/common.py:210
#, python-brace-format
msgid "working directory does not exist: {path}"
msgstr "工作目錄不存在：{path}"

#: lib/agentseat_cli/desktop.py:17
msgid "host Hyprland instance not found"
msgstr "找不到宿主 Hyprland 執行個體"

#: lib/agentseat_cli/desktop.py:58
msgid "host workspace must be a positive integer"
msgstr "宿主工作區必須是正整數"

#: lib/agentseat_cli/i18n.py:117
msgid "language must be auto, en, zh-CN, or zh-TW"
msgstr "語言必須是 auto、en、zh-CN 或 zh-TW"

#: lib/agentseat_cli/i18n.py:127
#, python-format
msgid "%(heading)s:"
msgstr "%(heading)s："

#: lib/agentseat_cli/i18n.py:128
msgid "usage: "
msgstr "用法："

