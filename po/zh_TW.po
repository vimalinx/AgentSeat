msgstr "AgentSeat 守護程式回應超過 1 MiB"

#: lib/agentseat_cli/transport.py:104
#, python-brace-format
msgid "cannot reach AgentSeat daemon: {error}"
msgstr "無法連線 AgentSeat 守護程式：{error}"

#: lib/agentseat_cli/transport.py:109
msgid "AgentSeat daemon returned no response"
msgstr "AgentSeat 守護程式未傳回回應"

#: lib/agentseat_cli/transport.py:113
#, python-brace-format
msgid "invalid AgentSeat daemon response: {error}"
msgstr "AgentSeat 守護程式回應無效：{error}"

#: lib/agentseat_cli/transport.py:115
