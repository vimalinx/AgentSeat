msgstr "連線暫時不可用"

#: native/agentseat-eye.c:611 native/agentseat-eye.c:639
#: native/agentseat-eye.c:729
msgid "Waiting for Agent"
msgstr "等待 Agent"

#: native/agentseat-eye.c:617
msgid "Continue"
msgstr "繼續"

#: native/agentseat-eye.c:617
msgid "Stop"
msgstr "停止"

#: native/agentseat-eye.c:618
msgid "Allow Agent input"
msgstr "允許 Agent 操作"

#: native/agentseat-eye.c:618
msgid "Stop Agent input"
msgstr "停止 Agent 操作"

#: native/agentseat-eye.c:633 native/agentseat-eye.c:635
msgid "AI is paused"
msgstr "AI 已暫停"

#: native/agentseat-eye.c:634
