msgstr "AgentSeat Wayland 輸入連線已斷開"

#: native/agentseat-input.c:648
msgid "Cannot flush AgentSeat input events"
msgstr "無法送出 AgentSeat 輸入事件"

#: native/agentseat-input.c:666
msgid "Pointer coordinates must be normalized from 0 to 1"
msgstr "游標座標必須正規化到 0 到 1"

#: native/agentseat-input.c:692
msgid "Button code is outside the supported range"
msgstr "按鈕代碼超出支援範圍"

#: native/agentseat-input.c:741
msgid "Keycode is outside the supported range"
msgstr "鍵碼超出支援範圍"

#: native/agentseat-input.c:768
msgid "Cannot allocate text input buffer"
msgstr "無法配置文字輸入緩衝區"

#: native/agentseat-input.c:781
msgid ""
"Text contains invalid UTF-8 or a character unavailable in the configured XKB "
"keymap"
msgstr "文字包含無效 UTF-8，或包含目前 XKB 鍵盤映射不可用的字元"

#: native/agentseat-input.c:789
msgid "A key became unavailable while typing"
msgstr "輸入時某個按鍵變得不可用"

#: native/agentseat-input.c:798
msgid "Cannot flush AgentSeat keyboard events"
msgstr "無法送出 AgentSeat 鍵盤事件"
