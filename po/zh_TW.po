#, python-format
msgid "argument '%(argument_name)s' is deprecated"
msgstr "參數“%(argument_name)s”已棄用"

#: lib/agentseat_cli/i18n.py:146
#, python-format
msgid "the following arguments are required: %s"
msgstr "必須提供以下參數：%s"

#: lib/agentseat_cli/i18n.py:147
#, python-format
msgid "one of the arguments %s is required"
msgstr "必須提供參數 %s 中的一個"

