msgstr "AgentSeat 外層視窗未出現"

#: lib/agentseat_cli/lifecycle.py:197
#, python-brace-format
msgid "AgentSeat outer window did not map on requested workspace {workspace}"
msgstr "AgentSeat 外層視窗未對映到指定工作區 {workspace}"

#: lib/agentseat_cli/lifecycle.py:203
#, python-brace-format
msgid "native AgentSeat daemon is missing or not executable: {path}"
msgstr "原生 AgentSeat 守護程式缺失或不可執行：{path}"

#: lib/agentseat_cli/lifecycle.py:206
msgid "AgentSeat application environment receipt did not appear"
msgstr "AgentSeat 應用程式環境回報未出現"

#: lib/agentseat_cli/lifecycle.py:208
msgid "application did not map in the AgentSeat micro-host"
msgstr "應用程式未對映到 AgentSeat 微宿主"

#: lib/agentseat_cli/lifecycle.py:245
msgid "AgentSeat daemon socket did not appear"
msgstr "AgentSeat 守護程式通訊端未出現"

#: lib/agentseat_cli/lifecycle.py:247
msgid "application window did not appear"
msgstr "應用程式視窗未出現"

#: lib/agentseat_cli/lifecycle.py:263
msgid "host focus isolation failed: before={before!r} after={after!r}"
msgstr "宿主焦點隔離失敗：之前={before!r} 之後={after!r}"

#: lib/agentseat_cli/lifecycle.py:361
msgid "AgentSeat is not running"
msgstr "AgentSeat 未執行"

#: lib/agentseat_cli/lifecycle.py:366
msgid "AgentSeat daemon returned an invalid session identity"
msgstr "AgentSeat 守護程式傳回了無效的工作階段識別碼"

#: lib/agentseat_cli/lifecycle.py:370
#, python-brace-format
msgid ""
"AgentSeat runtime state belongs to a different session: expected {expected}, "
"got {actual}"
msgstr ""
"AgentSeat 執行階段狀態屬於另一個工作階段：預期 {expected}，實際 {actual}"

#: lib/agentseat_cli/lifecycle.py:377
#, python-brace-format
msgid "AgentSeat session changed: expected {expected}, got {actual}"
msgstr "AgentSeat 工作階段已變更：預期 {expected}，實際 {actual}"

#: lib/agentseat_cli/lifecycle.py:385
msgid "AgentSeat runtime state does not match the connected daemon"
msgstr "AgentSeat 執行階段狀態與已連線的守護程式不符"

#: lib/agentseat_cli/lifecycle.py:389
msgid "AgentSeat session has no usable application window"
msgstr "AgentSeat 工作階段沒有可用的應用程式視窗"

#: lib/agentseat_cli/lifecycle.py:407
msgid "watch interval must be between 0.1 and 3600 seconds"
msgstr "watch 間隔必須介於 0.1 到 3600 秒之間"

#: lib/agentseat_cli/lifecycle.py:409
msgid "watch count must be zero or a positive integer"
msgstr "watch 次數必須為 0 或正整數"

#: lib/agentseat_cli/lifecycle.py:448
#, python-brace-format
msgid "native AgentSeat eye HUD is missing or not executable: {path}"
msgstr "原生 AgentSeat 小腦袋 HUD 缺失或不可執行：{path}"

#: lib/agentseat_cli/lifecycle.py:452
msgid "AgentSeat must be running before its embedded AI head can start"
msgstr "必須先執行 AgentSeat，才能啟動嵌入式 AI 小腦袋"

#: lib/agentseat_cli/lifecycle.py:458
msgid "AgentSeat private Wayland display is unavailable"
msgstr "AgentSeat 私有 Wayland 顯示不可用"

#: lib/agentseat_cli/lifecycle.py:492
#, python-brace-format
msgid "AgentSeat eye HUD exited during startup; inspect {path}"
msgstr "AgentSeat 小腦袋 HUD 在啟動期間結束；請檢查 {path}"

#: lib/agentseat_cli/lifecycle.py:511
msgid "AgentSeat eye HUD did not stop"
msgstr "AgentSeat 小腦袋 HUD 未停止"

#: lib/agentseat_cli/lifecycle.py:544
msgid "daemon did not stop"
msgstr "守護程式未停止"

#: lib/agentseat_cli/lifecycle.py:551
#, python-brace-format
msgid "refusing to remove an unexpected AgentSeat socket: {path}"
msgstr "拒絕刪除異常的 AgentSeat 通訊端：{path}"

#: lib/agentseat_cli/lifecycle.py:562
msgid "AgentSeat micro-host did not stop"
msgstr "AgentSeat 微宿主未停止"

#: lib/agentseat_cli/observe.py:19
msgid "capture output must be an absolute .png path"
msgstr "截圖輸出必須是絕對 .png 路徑"

#: lib/agentseat_cli/observe.py:23
#, python-brace-format
msgid "capture output parent is unavailable: {error}"
msgstr "截圖輸出的父目錄不可用：{error}"

#: lib/agentseat_cli/observe.py:25
msgid "capture output parent must be a directory owned by the current user"
msgstr "截圖輸出的父目錄必須由目前使用者擁有"

#: lib/agentseat_cli/observe.py:28
msgid "capture output cannot be a symbolic link"
msgstr "截圖輸出不能是符號連結"

#: lib/agentseat_cli/observe.py:30
msgid ""
"existing capture output must be a regular file owned by the current user"
msgstr "既有截圖輸出必須是目前使用者擁有的一般檔案"

#: lib/agentseat_cli/observe.py:41
msgid "no leased application window is available"
msgstr "沒有可用的已授權應用程式視窗"

#: lib/agentseat_cli/transport.py:102
