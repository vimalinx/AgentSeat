msgid "expected one argument"
msgstr "需要一個參數"

#: lib/agentseat_cli/i18n.py:149
msgid "expected at most one argument"
msgstr "最多隻能提供一個參數"

#: lib/agentseat_cli/i18n.py:150
msgid "expected at least one argument"
msgstr "至少需要一個參數"

#: lib/agentseat_cli/i18n.py:151
#, python-format
msgid "unexpected option string: %s"
msgstr "意外的選項字串：%s"

#: lib/agentseat_cli/i18n.py:152
#, python-format
msgid "invalid %(type)s value: %(value)r"
msgstr "無效的 %(type)s 值：%(value)r"

#: lib/agentseat_cli/i18n.py:153
#, python-format
msgid "invalid choice: %(value)r (choose from %(choices)s)"
msgstr "無效選擇：%(value)r（可選：%(choices)s）"

#: lib/agentseat_cli/i18n.py:154
#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s：錯誤：%(message)s\n"

#: lib/agentseat_cli/i18n.py:155
#, python-format
msgid "%(prog)s: warning: %(message)s\n"
msgstr "%(prog)s：警告：%(message)s\n"

#: lib/agentseat_cli/instances.py:67
msgid ""
"instance identifier must use 1-48 letters, digits, dots, underscores, or "
"hyphens"
msgstr "執行個體識別碼必須由 1-48 個字母、數字、點、底線或連字號組成"

#: lib/agentseat_cli/instances.py:138
msgid "could not allocate a unique AgentSeat instance identifier"
msgstr "無法配置唯一的 AgentSeat 執行個體識別碼"

#: lib/agentseat_cli/instances.py:146
msgid "current host workspace is unavailable"
msgstr "目前的宿主工作區無法使用"

#: lib/agentseat_cli/instances.py:150 lib/agentseat_cli/instances.py:152
msgid "host workspace must be 'current' or a positive integer"
msgstr "宿主工作區必須是「current」或正整數"

#: lib/agentseat_cli/lifecycle.py:91
#, python-brace-format
msgid "unsupported display mode: {mode}"
msgstr "不支援的顯示模式：{mode}"

#: lib/agentseat_cli/lifecycle.py:128
#, python-brace-format
msgid "unknown legacy preset: {preset}"
msgstr "未知的舊版預設：{preset}"

#: lib/agentseat_cli/lifecycle.py:163
msgid ""
"AgentSeat is already running another application; stop it before launching a "
"different command"
msgstr "AgentSeat 正在執行另一個應用程式；請先停止它再啟動不同命令"

#: lib/agentseat_cli/lifecycle.py:166
msgid ""
"an unmanaged AgentSeat micro-host is already running; run agentseat stop "
"first"
msgstr "已有未受管理的 AgentSeat 微宿主在執行；請先執行 agentseat stop"

#: lib/agentseat_cli/lifecycle.py:189
msgid "AgentSeat micro-host did not appear"
msgstr "AgentSeat 微宿主未出現"

#: lib/agentseat_cli/lifecycle.py:193
