#: bin/agentseat:175
msgid "language must be auto, en, zh-CN, or zh-TW"
msgstr "語言必須是 auto、en、zh-CN 或 zh-TW"

#: bin/agentseat:185
#, python-format
msgid "%(heading)s:"
msgstr "%(heading)s："

#: bin/agentseat:186
msgid "usage: "
msgstr "用法："

#: bin/agentseat:187
#, python-format
msgid " (default: %(default)s)"
msgstr "（預設值：%(default)s）"

#: bin/agentseat:188
#, python-format
msgid "argument %(argument_name)s: %(message)s"
msgstr "參數 %(argument_name)s：%(message)s"

#: bin/agentseat:189
msgid "show program's version number and exit"
msgstr "顯示程式版本號並結束"

#: bin/agentseat:190
#, python-format
msgid "unknown parser %(parser_name)r (choices: %(choices)s)"
msgstr "未知解析器 %(parser_name)r（可選：%(choices)s）"

#: bin/agentseat:191
#, python-format
msgid "command '%(parser_name)s' is deprecated"
msgstr "命令“%(parser_name)s”已棄用"

#: bin/agentseat:192
#, python-format
msgid "argument \"-\" with mode %r"
msgstr "參數“-”使用模式 %r"

#: bin/agentseat:193
#, python-format
msgid "can't open '%(filename)s': %(error)s"
msgstr "無法開啟“%(filename)s”：%(error)s"

#: bin/agentseat:194
msgid "positional arguments"
msgstr "位置參數"

#: bin/agentseat:195
msgid "options"
msgstr "選項"

#: bin/agentseat:196
msgid "show this help message and exit"
msgstr "顯示這則說明訊息並結束"

#: bin/agentseat:197
msgid "subcommands"
msgstr "子命令"

#: bin/agentseat:198
#, python-format
msgid "unrecognized arguments: %s"
msgstr "無法識別的參數：%s"

#: bin/agentseat:199
#, python-format
msgid "not allowed with argument %s"
msgstr "不能與參數 %s 同時使用"

#: bin/agentseat:200
#, python-format
msgid "ambiguous option: %(option)s could match %(matches)s"
msgstr "選項不明確：%(option)s 可能符合 %(matches)s"

#: bin/agentseat:201
#, python-format
msgid "ignored explicit argument %r"
msgstr "已忽略明確指定的參數 %r"

#: bin/agentseat:202
#, python-format
msgid "option '%(option)s' is deprecated"
msgstr "選項“%(option)s”已棄用"

#: bin/agentseat:203
#, python-format
msgid "argument '%(argument_name)s' is deprecated"
msgstr "參數“%(argument_name)s”已棄用"

#: bin/agentseat:204
#, python-format
msgid "the following arguments are required: %s"
msgstr "必須提供以下參數：%s"

#: bin/agentseat:205
#, python-format
msgid "one of the arguments %s is required"
msgstr "必須提供參數 %s 中的一個"

#: bin/agentseat:206
msgid "expected one argument"
msgstr "需要一個參數"

#: bin/agentseat:207
msgid "expected at most one argument"
msgstr "最多隻能提供一個參數"

#: bin/agentseat:208
msgid "expected at least one argument"
msgstr "至少需要一個參數"

#: bin/agentseat:209
#, python-format
msgid "unexpected option string: %s"
msgstr "意外的選項字串：%s"

#: bin/agentseat:210
#, python-format
msgid "invalid %(type)s value: %(value)r"
msgstr "無效的 %(type)s 值：%(value)r"

#: bin/agentseat:211
#, python-format
msgid "invalid choice: %(value)r (choose from %(choices)s)"
msgstr "無效選擇：%(value)r（可選：%(choices)s）"

#: bin/agentseat:212
#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s：錯誤：%(message)s\n"

#: bin/agentseat:213
#, python-format
msgid "%(prog)s: warning: %(message)s\n"
msgstr "%(prog)s：警告：%(message)s\n"

#: bin/agentseat:232
#, python-brace-format
msgid "command failed: {command}"
msgstr "命令執行失敗：{command}"

#: bin/agentseat:252
msgid "memory-only; cleared when the daemon exits"
msgstr "僅存於記憶體；守護程式結束時清除"

#: bin/agentseat:253
msgid "volatile; removed by the user session runtime manager"
msgstr "暫存資料；由使用者工作階段管理器清除"

#: bin/agentseat:254
msgid "written only when observe is requested"
msgstr "僅在請求 observe 時寫入"

#: bin/agentseat:267
#, python-brace-format
msgid "cannot read AgentSeat configuration {path}: {error}"
msgstr "無法讀取 AgentSeat 設定 {path}：{error}"

#: bin/agentseat:271
msgid "AgentSeat configuration [general] must be a table"
msgstr "AgentSeat 設定中的 [general] 必須是 TOML 資料表"

#: bin/agentseat:280
msgid "general.default_workspace must be a positive integer"
msgstr "general.default_workspace 必須是正整數"

#: bin/agentseat:282
msgid "general.human_priority_grace_ms must be an integer from 0 to 60000"
msgstr "general.human_priority_grace_ms 必須是 0 到 60000 之間的整數"

#: bin/agentseat:284
msgid "general.eye_hud must be true or false"
msgstr "general.eye_hud 必須是 true 或 false"

#: bin/agentseat:286 bin/agentseat:290
msgid "general.language must be auto, en, zh-CN, or zh-TW"
msgstr "general.language 必須是 auto、en、zh-CN 或 zh-TW"

#: bin/agentseat:354
msgid "host Hyprland instance not found"
msgstr "找不到宿主 Hyprland 執行個體"

#: bin/agentseat:411
msgid "host workspace must be a positive integer"
msgstr "宿主工作區必須是正整數"

#: bin/agentseat:499
msgid "AgentSeat daemon response exceeds 1 MiB"
msgstr "AgentSeat 守護程式回應超過 1 MiB"

#: bin/agentseat:501
#, python-brace-format
msgid "cannot reach AgentSeat daemon: {error}"
msgstr "無法連線 AgentSeat 守護程式：{error}"

#: bin/agentseat:503
msgid "AgentSeat daemon returned no response"
msgstr "AgentSeat 守護程式未傳回回應"

#: bin/agentseat:507
#, python-brace-format
msgid "invalid AgentSeat daemon response: {error}"
msgstr "AgentSeat 守護程式回應無效：{error}"

#: bin/agentseat:509
msgid "AgentSeat daemon response ID mismatch"
msgstr "AgentSeat 守護程式回應 ID 不相符"

#: bin/agentseat:513
msgid "AgentSeat daemon rejected the request"
msgstr "AgentSeat 守護程式拒絕了請求"

#: bin/agentseat:543
msgid "run requires a non-empty command after --"
msgstr "run 要求在 -- 後提供命令"

#: bin/agentseat:552
#, python-brace-format
msgid "working directory does not exist: {path}"
msgstr "工作目錄不存在：{path}"

#: bin/agentseat:558
#, python-brace-format
msgid "unsupported display mode: {mode}"
msgstr "不支援的顯示模式：{mode}"

#: bin/agentseat:589
#, python-brace-format
msgid "unknown legacy preset: {preset}"
msgstr "未知的舊版預設：{preset}"

#: bin/agentseat:624
msgid ""
"AgentSeat is already running another application; stop it before launching a "
"different command"
msgstr "AgentSeat 正在執行另一個應用程式；請先停止它再啟動不同命令"

#: bin/agentseat:627
msgid ""
"an unmanaged AgentSeat micro-host is already running; run agentseat stop "
"first"
msgstr "已有未受管理的 AgentSeat 微宿主在執行；請先執行 agentseat stop"

#: bin/agentseat:650
msgid "AgentSeat micro-host did not appear"
msgstr "AgentSeat 微宿主未出現"

#: bin/agentseat:654
msgid "outer AgentSeat window did not appear"
msgstr "AgentSeat 外層視窗未出現"

#: bin/agentseat:658
#, python-brace-format
msgid "AgentSeat outer window did not map on requested workspace {workspace}"
msgstr "AgentSeat 外層視窗未對映到指定工作區 {workspace}"

#: bin/agentseat:664
#, python-brace-format
msgid "native AgentSeat daemon is missing or not executable: {path}"
msgstr "原生 AgentSeat 守護程式缺失或不可執行：{path}"

#: bin/agentseat:668
#, python-brace-format
msgid "native wlr-screencopy client is missing or not executable: {path}"
msgstr "原生 wlr-screencopy 用戶端不存在或無法執行：{path}"

#: bin/agentseat:671
msgid "AgentSeat application environment receipt did not appear"
msgstr "AgentSeat 應用程式環境回報未出現"

#: bin/agentseat:673
msgid "application did not map in the AgentSeat micro-host"
msgstr "應用程式未對映到 AgentSeat 微宿主"

#: bin/agentseat:706
msgid "AgentSeat daemon socket did not appear"
msgstr "AgentSeat 守護程式通訊端未出現"

#: bin/agentseat:708
msgid "application window did not appear"
msgstr "應用程式視窗未出現"

#: bin/agentseat:725
msgid "host focus isolation failed: before={before!r} after={after!r}"
msgstr "宿主焦點隔離失敗：之前={before!r} 之後={after!r}"

#: bin/agentseat:809
#, python-brace-format
msgid "native AgentSeat eye HUD is missing or not executable: {path}"
msgstr "原生 AgentSeat 小腦袋 HUD 缺失或不可執行：{path}"

#: bin/agentseat:813
msgid "AgentSeat must be running before its embedded AI head can start"
msgstr "必須先執行 AgentSeat，才能啟動嵌入式 AI 小腦袋"

#: bin/agentseat:819
msgid "AgentSeat private Wayland display is unavailable"
msgstr "AgentSeat 私有 Wayland 顯示不可用"

#: bin/agentseat:849
#, python-brace-format
msgid "AgentSeat eye HUD exited during startup; inspect {path}"
msgstr "AgentSeat 小腦袋 HUD 在啟動期間結束；請檢查 {path}"

#: bin/agentseat:868
msgid "AgentSeat eye HUD did not stop"
msgstr "AgentSeat 小腦袋 HUD 未停止"

#: bin/agentseat:891
msgid "daemon did not stop"
msgstr "守護程式未停止"

#: bin/agentseat:898
#, python-brace-format
msgid "refusing to remove an unexpected AgentSeat socket: {path}"
msgstr "拒絕刪除異常的 AgentSeat 通訊端：{path}"

#: bin/agentseat:907
msgid "AgentSeat micro-host did not stop"
msgstr "AgentSeat 微宿主未停止"

#: bin/agentseat:947
msgid "private X display is unavailable"
msgstr "私有 X 顯示不可用"

#: bin/agentseat:955
msgid "no OnlyOffice window is available"
msgstr "沒有可用的 OnlyOffice 視窗"

#: bin/agentseat:968
msgid "private X clipboard owner failed"
msgstr "私有 X 剪貼簿所有者失敗"

#: bin/agentseat:987
msgid "OnlyOffice Paste menu item was not visually detected"
msgstr "未能從畫面中識別 OnlyOffice 的“貼上”選單項"

#: bin/agentseat:1014
msgid "private Wayland display is unavailable"
msgstr "私有 Wayland 顯示不可用"

#: bin/agentseat:1018
#, python-brace-format
msgid "private Unicode clipboard helper is unavailable: {path}"
msgstr "私有 Unicode 剪貼簿輔助程式不可用：{path}"

#: bin/agentseat:1035
msgid "private clipboard input pipe is unavailable"
msgstr "私有剪貼簿輸入管道不可用"

#: bin/agentseat:1045
msgid "private AgentSeat clipboard did not become ready"
msgstr "AgentSeat 私有剪貼簿未就緒"

#: bin/agentseat:1055
msgid "application did not request the private AgentSeat clipboard"
msgstr "應用程式未請求 AgentSeat 私有剪貼簿"

#: bin/agentseat:1058
msgid "private AgentSeat clipboard transfer failed"
msgstr "AgentSeat 私有剪貼簿傳輸失敗"

#: bin/agentseat:1078
msgid "capture output must be an absolute .png path"
msgstr "截圖輸出必須是絕對 .png 路徑"

#: bin/agentseat:1082
#, python-brace-format
msgid "capture output parent is unavailable: {error}"
msgstr "截圖輸出的父目錄不可用：{error}"

#: bin/agentseat:1084
msgid "capture output parent must be a directory owned by the current user"
msgstr "截圖輸出的父目錄必須由目前使用者擁有"

#: bin/agentseat:1087
msgid "capture output cannot be a symbolic link"
msgstr "截圖輸出不能是符號連結"

#: bin/agentseat:1089
msgid ""
"existing capture output must be a regular file owned by the current user"
msgstr "既有截圖輸出必須是目前使用者擁有的一般檔案"

#: bin/agentseat:1100
msgid "no leased application window is available"
msgstr "沒有可用的已授權應用程式視窗"

#: bin/agentseat:1113
msgid "AgentSeat micro-host exited before capture"
msgstr "AgentSeat 微宿主在截圖前已結束"

