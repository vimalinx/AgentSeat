#, python-format
msgid "argument %(argument_name)s: %(message)s"
msgstr "參數 %(argument_name)s：%(message)s"

#: lib/agentseat_cli/i18n.py:131
msgid "show program's version number and exit"
msgstr "顯示程式版本號並結束"

#: lib/agentseat_cli/i18n.py:132
#, python-format
msgid "unknown parser %(parser_name)r (choices: %(choices)s)"
msgstr "未知解析器 %(parser_name)r（可選：%(choices)s）"

