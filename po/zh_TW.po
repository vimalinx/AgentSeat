#, python-format
msgid "command '%(parser_name)s' is deprecated"
msgstr "命令“%(parser_name)s”已棄用"

#: lib/agentseat_cli/i18n.py:134
#, python-format
msgid "argument \"-\" with mode %r"
msgstr "參數“-”使用模式 %r"

