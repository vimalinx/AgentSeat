msgstr "无法刷新 AgentSeat 输入事件"

#: native/agentseat-input.c:793
msgid "Pointer coordinates must be normalized from 0 to 1"
msgstr "指针坐标必须归一化到 0 到 1"

#: native/agentseat-input.c:820
msgid "Button code is outside the supported range"
msgstr "按钮代码超出支持范围"

#: native/agentseat-input.c:871
msgid "Keycode is outside the supported range"
msgstr "键码超出支持范围"

#: native/agentseat-input.c:895
