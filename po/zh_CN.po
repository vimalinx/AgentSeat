#, python-format
msgid "command '%(parser_name)s' is deprecated"
msgstr "命令“%(parser_name)s”已弃用"

#: bin/agentseat:192
#, python-format
msgid "argument \"-\" with mode %r"
msgstr "参数“-”使用模式 %r"

#: bin/agentseat:193
#, python-format
msgid "can't open '%(filename)s': %(error)s"
msgstr "无法打开“%(filename)s”：%(error)s"

#: bin/agentseat:194
msgid "positional arguments"
msgstr "位置参数"

#: bin/agentseat:195
msgid "options"
msgstr "选项"

#: bin/agentseat:196
msgid "show this help message and exit"
msgstr "显示此帮助信息并退出"

#: bin/agentseat:197
msgid "subcommands"
msgstr "子命令"

#: bin/agentseat:198
#, python-format
msgid "unrecognized arguments: %s"
msgstr "无法识别的参数：%s"

#: bin/agentseat:199
#, python-format
msgid "not allowed with argument %s"
msgstr "不能与参数 %s 同时使用"

#: bin/agentseat:200
#, python-format
msgid "ambiguous option: %(option)s could match %(matches)s"
msgstr "选项不明确：%(option)s 可能匹配 %(matches)s"

#: bin/agentseat:201
#, python-format
msgid "ignored explicit argument %r"
msgstr "已忽略显式参数 %r"

#: bin/agentseat:202
#, python-format
msgid "option '%(option)s' is deprecated"
msgstr "选项“%(option)s”已弃用"

#: bin/agentseat:203
#, python-format
msgid "argument '%(argument_name)s' is deprecated"
msgstr "参数“%(argument_name)s”已弃用"

#: bin/agentseat:204
#, python-format
msgid "the following arguments are required: %s"
msgstr "必须提供以下参数：%s"

#: bin/agentseat:205
#, python-format
msgid "one of the arguments %s is required"
msgstr "必须提供参数 %s 中的一个"

#: bin/agentseat:206
msgid "expected one argument"
msgstr "需要一个参数"

#: bin/agentseat:207
msgid "expected at most one argument"
msgstr "最多只能提供一个参数"

#: bin/agentseat:208
msgid "expected at least one argument"
msgstr "至少需要一个参数"

#: bin/agentseat:209
#, python-format
msgid "unexpected option string: %s"
msgstr "意外的选项字符串：%s"

#: bin/agentseat:210
#, python-format
msgid "invalid %(type)s value: %(value)r"
msgstr "无效的 %(type)s 值：%(value)r"

#: bin/agentseat:211
#, python-format
msgid "invalid choice: %(value)r (choose from %(choices)s)"
msgstr "无效选择：%(value)r（可选：%(choices)s）"

#: bin/agentseat:212
#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s：错误：%(message)s\n"

#: bin/agentseat:213
#, python-format
msgid "%(prog)s: warning: %(message)s\n"
msgstr "%(prog)s：警告：%(message)s\n"

#: bin/agentseat:232
#, python-brace-format
msgid "command failed: {command}"
msgstr "命令执行失败：{command}"

#: bin/agentseat:252
msgid "memory-only; cleared when the daemon exits"
msgstr "仅存于内存；守护进程退出时清除"

#: bin/agentseat:253
msgid "volatile; removed by the user session runtime manager"
msgstr "临时数据；由用户会话运行时管理器清除"

#: bin/agentseat:254
msgid "written only when observe is requested"
msgstr "仅在请求 observe 时写入"

#: bin/agentseat:267
#, python-brace-format
msgid "cannot read AgentSeat configuration {path}: {error}"
msgstr "无法读取 AgentSeat 配置 {path}：{error}"

#: bin/agentseat:271
msgid "AgentSeat configuration [general] must be a table"
msgstr "AgentSeat 配置中的 [general] 必须是表"

#: bin/agentseat:280
msgid "general.default_workspace must be a positive integer"
msgstr "general.default_workspace 必须是正整数"

#: bin/agentseat:282
msgid "general.human_priority_grace_ms must be an integer from 0 to 60000"
msgstr "general.human_priority_grace_ms 必须是 0 到 60000 之间的整数"

#: bin/agentseat:284
msgid "general.eye_hud must be true or false"
msgstr "general.eye_hud 必须是 true 或 false"

#: bin/agentseat:286 bin/agentseat:290
msgid "general.language must be auto, en, zh-CN, or zh-TW"
msgstr "general.language 必须是 auto、en、zh-CN 或 zh-TW"

#: bin/agentseat:354
msgid "host Hyprland instance not found"
msgstr "找不到宿主 Hyprland 实例"

#: bin/agentseat:411
msgid "host workspace must be a positive integer"
msgstr "宿主工作区必须是正整数"

#: bin/agentseat:499
msgid "AgentSeat daemon response exceeds 1 MiB"
msgstr "AgentSeat 守护进程响应超过 1 MiB"

#: bin/agentseat:501
#, python-brace-format
msgid "cannot reach AgentSeat daemon: {error}"
msgstr "无法连接 AgentSeat 守护进程：{error}"

#: bin/agentseat:503
msgid "AgentSeat daemon returned no response"
msgstr "AgentSeat 守护进程没有返回响应"

#: bin/agentseat:507
#, python-brace-format
msgid "invalid AgentSeat daemon response: {error}"
msgstr "AgentSeat 守护进程响应无效：{error}"

#: bin/agentseat:509
msgid "AgentSeat daemon response ID mismatch"
msgstr "AgentSeat 守护进程响应 ID 不匹配"

#: bin/agentseat:513
msgid "AgentSeat daemon rejected the request"
msgstr "AgentSeat 守护进程拒绝了请求"

#: bin/agentseat:543
msgid "run requires a non-empty command after --"
msgstr "run 要求在 -- 后提供非空命令"

#: bin/agentseat:552
#, python-brace-format
msgid "working directory does not exist: {path}"
msgstr "工作目录不存在：{path}"

#: bin/agentseat:558
#, python-brace-format
msgid "unsupported display mode: {mode}"
msgstr "不支持的显示模式：{mode}"

#: bin/agentseat:589
#, python-brace-format
msgid "unknown legacy preset: {preset}"
msgstr "未知的旧版预设：{preset}"

#: bin/agentseat:624
msgid ""
"AgentSeat is already running another application; stop it before launching a "
"different command"
msgstr "AgentSeat 正在运行另一个应用；请先停止它再启动不同命令"

#: bin/agentseat:627
msgid ""
"an unmanaged AgentSeat micro-host is already running; run agentseat stop "
"first"
msgstr "已有未受管理的 AgentSeat 微宿主在运行；请先执行 agentseat stop"

