msgid "outer AgentSeat window did not appear"
msgstr "AgentSeat 外层窗口未出现"

#: bin/agentseat:658
#, python-brace-format
msgid "AgentSeat outer window did not map on requested workspace {workspace}"
msgstr "AgentSeat 外层窗口未映射到指定工作区 {workspace}"

#: bin/agentseat:664
#, python-brace-format
msgid "native AgentSeat daemon is missing or not executable: {path}"
msgstr "原生 AgentSeat 守护进程缺失或不可执行：{path}"

