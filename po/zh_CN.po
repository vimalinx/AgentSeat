msgstr "等待 Agent"

#: native/agentseat-eye.c:551
msgid "You're in control · AI stepped aside"
msgstr "你正在操作 · AI 已让路"

#: native/agentseat-eye.c:552 native/agentseat-eye.c:628
msgid "AI can operate"
msgstr "AI 可操作"

#: native/agentseat-eye.c:552
msgid "AI is paused"
msgstr "AI 已暂停"

#: native/agentseat-eye.c:560
msgid "Waiting for AgentSeat"
msgstr "正在等待 AgentSeat"

#: native/agentseat-eye.c:628
msgid "Connecting"
msgstr "正在连接"

#: native/agentseat-eye.c:634
msgid "Reviewing the table layout"
msgstr "正在检查文档里的表格布局"

#: native/agentseat-eye.c:645
msgid ""
"AgentSeat clicks only inside this app. When you take over, AI pauses "
"automatically."
msgstr "只在 AgentSeat 应用内点击；你一动手，AI 会自动暂停。"

