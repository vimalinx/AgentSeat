msgstr "我正在核对第 3 页的表格边距，还没有改动正文。"

#: native/agentseat-eye.c:672
msgid ""
"Align the header first. Wait for my confirmation before changing the body."
msgstr "先把表头对齐，正文等我确认。"

#: native/agentseat-eye.c:692
msgid "Tell AI what to do next…"
msgstr "告诉 AI 接下来做什么…"

#: native/agentseat-eye.c:696
msgid "Message AgentSeat AI"
msgstr "给 AgentSeat AI 发消息"

#: native/agentseat-eye.c:699
msgid "Send message"
msgstr "发送消息"

#: native/agentseat-eye.c:777
msgid "host compositor does not support layer shell"
msgstr "宿主合成器不支持 layer shell"

#: native/agentseat-eye.c:855
#, c-format
msgid "usage: %s [--socket PATH] [--demo] [--embedded] [--render-head PNG]\n"
msgstr "用法：%s [--socket 路径] [--demo] [--embedded] [--render-head PNG]\n"

#: native/agentseat-eye.c:876
#, c-format
msgid "agentseat-eye: cannot render head: %s\n"
msgstr "agentseat-eye：无法渲染小脑袋：%s\n"

#: native/agentseatd.c:105
msgid "AgentSeat request failed"
msgstr "AgentSeat 请求失败"

#: native/agentseatd.c:155
msgid "Native AgentSeat input failed"
msgstr "原生 AgentSeat 输入失败"

#: native/agentseatd.c:161
msgid "Required string parameter is missing"
msgstr "缺少必需的字符串参数"

#: native/agentseatd.c:166
msgid "String parameter must not be empty"
msgstr "字符串参数不能为空"

#: native/agentseatd.c:179
msgid "Boolean parameter has the wrong type"
msgstr "布尔参数类型错误"

#: native/agentseatd.c:191
msgid "Optional string parameter has the wrong type"
msgstr "可选字符串参数类型错误"

#: native/agentseatd.c:278
msgid "Call seat.create before using AgentSeat"
msgstr "使用 AgentSeat 前请先调用 seat.create"

#: native/agentseatd.c:288
msgid "Agent seat is paused"
msgstr "Agent 席位已暂停"

#: native/agentseatd.c:297
#, c-format
msgid "Human input has priority; retry after %d ms of quiet"
msgstr "人类输入优先；静置 %d 毫秒后重试"

#: native/agentseatd.c:309
msgid "Focus a leased window before sending input"
msgstr "发送输入前请聚焦已授权窗口"

#: native/agentseatd.c:414
msgid "Activity text exceeds the AgentSeat collaboration limit"
msgstr "活动文本超过 AgentSeat 协作限制"

#: native/agentseatd.c:426
msgid "Chat text exceeds the AgentSeat collaboration limit"
msgstr "聊天文本超过 AgentSeat 协作限制"

#: native/agentseatd.c:437
msgid "after_id must be a non-negative integer"
msgstr "after_id 必须是非负整数"

#: native/agentseatd.c:529
msgid "Window is not leased to AgentSeat"
msgstr "窗口未授权给 AgentSeat"

#: native/agentseatd.c:533
msgid "The single-app micro-host has no such window"
msgstr "单应用微宿主中没有该窗口"

#: native/agentseatd.c:540
msgid "Capture the micro-host output through wlr-screencopy"
msgstr "请通过 wlr-screencopy 截取微宿主输出"

#: native/agentseatd.c:548
msgid "Too many windows are mapped in the wrapped application"
msgstr "被封装应用映射的窗口过多"

#: native/agentseatd.c:563
msgid "pointer.move_absolute requires x and y"
msgstr "pointer.move_absolute 需要 x 和 y"

#: native/agentseatd.c:569
msgid "x and y must be normalized from 0 to 1"
msgstr "x 和 y 必须归一化到 0 到 1"

#: native/agentseatd.c:588
msgid "pointer.button requires button and pressed"
msgstr "pointer.button 需要 button 和 pressed"

#: native/agentseatd.c:593
msgid "button must be an integer from 1 to 1023"
msgstr "button 必须是 1 到 1023 之间的整数"

#: native/agentseatd.c:610
msgid "pointer.scroll requires axis and value120"
msgstr "pointer.scroll 需要 axis 和 value120"

#: native/agentseatd.c:614
msgid "axis must be vertical or horizontal"
msgstr "axis 必须是 vertical 或 horizontal"

#: native/agentseatd.c:619
msgid "value120 must be from -12000 to 12000"
msgstr "value120 必须在 -12000 到 12000 之间"

#: native/agentseatd.c:641
msgid "text exceeds the native AgentSeat input limit"
msgstr "文本超过原生 AgentSeat 输入限制"

#: native/agentseatd.c:647
msgid "interval_ms must be from 0 to 10000"
msgstr "interval_ms 必须在 0 到 10000 之间"

#: native/agentseatd.c:676
