msgid "Unknown native AgentSeat method"
msgstr "未知的原生 AgentSeat 方法"

#: native/agentseatd.c:717
msgid "method must be a non-empty string"
msgstr "method 必须是非空字符串"

#: native/agentseatd.c:722
msgid "params must be an object"
