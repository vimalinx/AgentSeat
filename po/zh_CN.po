#: native/agentseatd.c:1161
msgid "pointer.move_absolute requires x and y"
msgstr "pointer.move_absolute 需要 x 和 y"

#: native/agentseatd.c:1167
msgid "x and y must be normalized from 0 to 1"
msgstr "x 和 y 必须归一化到 0 到 1"

#: native/agentseatd.c:1209
msgid "pointer.button requires button and pressed"
msgstr "pointer.button 需要 button 和 pressed"

#: native/agentseatd.c:1214
msgid "button must be an integer from 1 to 1023"
msgstr "button 必须是 1 到 1023 之间的整数"

#: native/agentseatd.c:1231
msgid "pointer.scroll requires axis and value120"
msgstr "pointer.scroll 需要 axis 和 value120"

#: native/agentseatd.c:1235
msgid "axis must be vertical or horizontal"
msgstr "axis 必须是 vertical 或 horizontal"

#: native/agentseatd.c:1240
msgid "value120 must be from -12000 to 12000"
msgstr "value120 必须在 -12000 到 12000 之间"

#: native/agentseatd.c:1302
msgid "text exceeds the native AgentSeat input limit"
msgstr "文本超过原生 AgentSeat 输入限制"

#: native/agentseatd.c:1315
msgid "interval_ms must be from 0 to 10000"
msgstr "interval_ms 必须在 0 到 10000 之间"

#: native/agentseatd.c:1353
msgid "keyboard.key requires keycode and pressed"
msgstr "keyboard.key 需要 keycode 和 pressed"

#: native/agentseatd.c:1358
msgid "keycode must be an evdev code from 0 to 767"
msgstr "keycode 必须是 0 到 767 之间的 evdev 代码"

#: native/agentseatd.c:1375
msgid "Unknown native AgentSeat method"
msgstr "未知的原生 AgentSeat 方法"

#: native/agentseatd.c:1409
msgid "params must be an object"
msgstr "params 必须是对象"

#: native/agentseatd.c:1502
msgid "Native AgentSeat request failed"
msgstr "原生 AgentSeat 请求失败"

#: native/agentseatd.c:1534
msgid "Cannot create AgentSeat runtime directory"
msgstr "无法创建 AgentSeat 运行时目录"

#: native/agentseatd.c:1540
msgid "Cannot create AgentSeat Unix socket"
msgstr "无法创建 AgentSeat Unix 套接字"

#: native/agentseatd.c:1545
msgid "AgentSeat socket path is too long"
msgstr "AgentSeat 套接字路径过长"

#: native/agentseatd.c:1550
msgid "Cannot bind AgentSeat Unix socket"
msgstr "无法绑定 AgentSeat Unix 套接字"

#: native/agentseatd.c:1556
msgid "Cannot create AgentSeat activity runtime directory"
msgstr "无法创建 AgentSeat 活动运行时目录"

#: native/agentseatd.c:1562
msgid "Cannot create AgentSeat human activity socket"
msgstr "无法创建 AgentSeat 人类活动套接字"

#: native/agentseatd.c:1567
msgid "AgentSeat activity socket path is too long"
msgstr "AgentSeat 活动套接字路径过长"

#: native/agentseatd.c:1572
msgid "Cannot bind AgentSeat human activity socket"
msgstr "无法绑定 AgentSeat 人类活动套接字"

#: native/agentseatd.c:1722
msgid "input dispatch failed"
msgstr "输入分发失败"

#: native/agentseatd.c:1791
#, c-format
msgid ""
"usage: %s --socket PATH --activity-socket PATH [--session-id ID] [--human-"
"grace-ms N] [--workspace N] [--seat-id ID] [--seat-name NAME] [--app-id ID] "
"[--window-title TITLE] [--xwayland] [--width N] [--height N]\n"
msgstr ""
"用法：%s --socket 路径 --activity-socket 路径 [--session-id ID] [--human-"
"grace-ms N] [--workspace N] [--seat-id ID] [--seat-name 名称] [--app-id ID] "
"[--window-title 标题] [--xwayland] [--width N] [--height N]\n"

