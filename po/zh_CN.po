#: bin/agentseat:175
msgid "language must be auto, en, zh-CN, or zh-TW"
msgstr "语言必须是 auto、en、zh-CN 或 zh-TW"

#: bin/agentseat:185
#, python-format
msgid "%(heading)s:"
msgstr "%(heading)s："

#: bin/agentseat:186
msgid "usage: "
msgstr "用法："

#: bin/agentseat:187
#, python-format
msgid " (default: %(default)s)"
msgstr "（默认值：%(default)s）"

#: bin/agentseat:188
#, python-format
msgid "argument %(argument_name)s: %(message)s"
msgstr "参数 %(argument_name)s：%(message)s"

#: bin/agentseat:189
msgid "show program's version number and exit"
msgstr "显示程序版本号并退出"

#: bin/agentseat:190
#, python-format
msgid "unknown parser %(parser_name)r (choices: %(choices)s)"
msgstr "未知解析器 %(parser_name)r（可选：%(choices)s）"

